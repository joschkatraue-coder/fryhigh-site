---
import { getEntry } from "astro:content";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/Hero.astro";
import StatsStrip from "../components/StatsStrip.astro";
import NewsletterCTA from "../components/NewsletterCTA.astro";

const home = await getEntry("home", "home");
if (!home) throw new Error("src/content/home.md fehlt — Home-Singleton ist Pflicht.");

const { hero, stats, newsletter } = home.data;
---
<MarketingLayout
  title="Fry High — First Class Fritten · Bremerhaven seit 2020"
  description="Loaded Fries, Smashburger, Catering. Eigene Kreationen aus dem Foodtruck und vom Zoo am Meer."
>
  <Hero
    eyebrow={hero.eyebrow}
    headline_lines={hero.headline_lines}
    lead={hero.lead}
    ctas={hero.ctas}
  />

  <StatsStrip stats={stats} />

  <section class="placeholder">
    <span class="eyebrow">Phase A · in Entwicklung</span>
    <h2>Restliche Sektionen folgen.</h2>
    <p class="lead">
      Live-Tagestafel · Pommes-Kreationen · Standorte · Abendgeschäft ·
      Catering · Kindergeburtstag · Story · Pantry.
    </p>
  </section>

  <NewsletterCTA headline={newsletter.headline} lead={newsletter.lead} />
</MarketingLayout>

<style>
  .placeholder {
    max-width: var(--container-wide);
    margin: var(--space-8) auto;
    padding: var(--space-9) var(--space-6);
    display: grid;
    gap: var(--space-4);
    background: var(--surface);
    border-radius: var(--r-lg);
  }
</style>
