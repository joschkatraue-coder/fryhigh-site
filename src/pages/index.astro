---
import { getEntry } from "astro:content";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/Hero.astro";
import Catering from "../components/Catering.astro";
import Winter from "../components/Winter.astro";

const home = await getEntry("home", "home");
const catering = await getEntry("catering", "catering");
const winter = await getEntry("winter", "winter");
if (!home || !catering || !winter) throw new Error("Inhalte für Startseite, Catering oder Winter fehlen.");
---
<MarketingLayout
  title="Fry High · Smashburger, Loaded Fries & Catering in Bremerhaven"
  description="Smashburger, Loaded Fries und Wings in Bremerhaven: ab 13.11. Do bis Sa ab 17:30 Uhr im Restaurant am Zoo am Meer. Catering und Feiern auf Anfrage."
>
  <Hero {...home.data.hero} />
  <Catering {...catering.data} />
  <Winter {...winter.data} />
</MarketingLayout>
