---
import { getEntry } from "astro:content";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/Hero.astro";
import Catering from "../components/Catering.astro";
import Winter from "../components/Winter.astro";

const home = await getEntry("home", "home");
const catering = await getEntry("catering", "catering");
const winter = await getEntry("winter", "winter");
if (!home || !catering || !winter) throw new Error("Inhalte für Startseite, Catering oder Winter fehlen.");
---
<MarketingLayout
  title="Fry High · Catering & Feiern in Bremerhaven"
  description="Loaded Fries und Smashburger für eure Feier. Fry High aus Bremerhaven: Catering mit Foodtruck oder Crew, Weihnachtsfeiern und Grünkohl auf Anfrage."
>
  <Hero {...home.data.hero} />
  <Catering {...catering.data} />
  <Winter {...winter.data} />
</MarketingLayout>
