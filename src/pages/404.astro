---
/* 404. Texte aus copy-master.md §15: der Pilot bleibt Erzählanker, Airline-Wörter sind raus;
   „Fryheit“ nur hier als Easter-Egg (F41). Strip einzeilig, Buttons .fh-btn / .fh-btn--ghost,
   Mascot nur ab 1024 px. */
import MarketingLayout from "../layouts/MarketingLayout.astro";
import FloatingMascot from "../components/FloatingMascot.astro";
---
<MarketingLayout
  title="Seite verloren · Fry High"
  description="Diese Seite gibt es nicht. Zurück zur Karte, da gibt es Loaded Fries."
  noindex={true}
>
  <section class="four-oh-four has-mascot">
    <FloatingMascot
      image="08_Seehund_Fries_Garnelen.png"
      size={160}
      rotate={-10}
      top="10%"
      right="6%"
    />

    <div class="strip">
      <span>Fehler 404</span>
    </div>

    <div class="frame">
      <span class="eyebrow">Hier gibt es nichts zu essen</span>
      <h1>
        Seite<br />
        <span class="acc">verloren.</span>
      </h1>
      <p class="lead">
        Der Pilot war hier noch nicht. Vielleicht kommt er mal vorbei, vielleicht nie. Zurück zur Karte, da gibt es Loaded Fries.
      </p>

      <div class="actions">
        <a class="fh-btn" href="/">Zurück zur Startseite</a>
        <a class="fh-btn fh-btn--ghost" href="/#karte">Zur Karte</a>
      </div>

      <div class="hints">
        <span class="hints-eyebrow">Du suchst vielleicht:</span>
        <ul>
          <li><a href="/#karte">Karte</a></li>
          <li><a href="/#standorte">Standort</a></li>
          <li><a href="/#catering">Catering</a></li>
          <li><a href="/#winter">Winter</a></li>
        </ul>
      </div>

      <p class="egg">
        <a class="fh-link" href="https://instagram.com/fry_high2020" target="_blank" rel="noopener">Folge der Fryheit.</a>
      </p>
    </div>
  </section>
</MarketingLayout>

<style>
  .four-oh-four {
    min-height: 78vh;
    display: grid;
    grid-template-rows: auto 1fr;
    background:
      radial-gradient(circle at 18% 28%, color-mix(in oklab, var(--orange) 12%, transparent) 0%, transparent 38%),
      radial-gradient(circle at 82% 72%, color-mix(in oklab, var(--yellow) 10%, transparent) 0%, transparent 40%),
      var(--navy-deep);
    color: var(--cream);
    padding: clamp(20px, 4vw, 36px);
    position: relative;
    overflow: hidden;
  }

  .strip {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-min);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--yellow);
    border: 1px solid color-mix(in oklab, var(--yellow) 35%, transparent);
  }

  .frame {
    align-self: center;
    max-width: 720px;
    margin: clamp(40px, 8vw, 80px) auto;
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--yellow);
    opacity: 1;
    display: inline-block;
    margin-bottom: 18px;
  }

  .frame h1 {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 14vw, 10rem);
    line-height: 0.86;
    letter-spacing: -2px;
    text-transform: uppercase;
    color: var(--cream);
    margin: 0 0 22px;
    text-shadow: 0 8px 28px rgba(0, 0, 0, 0.4);
  }

  .frame h1 .acc {
    color: var(--orange);
  }

  .lead {
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.0625rem, 2.2vw, 1.375rem);
    line-height: 1.5;
    color: color-mix(in oklab, var(--cream) 88%, transparent);
    max-width: 56ch;
    margin: 0 auto 36px;
  }

  .actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-bottom: 56px;
  }

  .hints {
    padding-top: 28px;
    border-top: 1px dashed color-mix(in oklab, var(--cream) 22%, transparent);
  }

  .hints-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-mono-min);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--cream) 70%, transparent);
    display: block;
    margin-bottom: 12px;
  }

  .hints ul {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hints a {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--cream);
    border-bottom: 1px solid color-mix(in oklab, var(--orange) 50%, transparent);
    padding-bottom: 2px;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .hints a:hover,
  .hints a:focus-visible {
    color: var(--orange);
    border-bottom-color: var(--orange);
  }

  .egg {
    margin-top: 36px;
  }

  .egg .fh-link {
    font-size: var(--t-mono-min);
    opacity: 0.8;
  }

  .egg .fh-link:hover,
  .egg .fh-link:focus-visible {
    opacity: 1;
  }

  /* Mascot nur ab 1024 px: darunter kollidiert es mit der zentrierten Textspalte. */
  @media (max-width: 1023px) {
    .four-oh-four > :global(.mascot) {
      display: none;
    }
  }
</style>
