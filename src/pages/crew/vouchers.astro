---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Crew-Tool für Gutscheine aus dem Pommespilot-Gewinnspiel. Intern, noindex, per robots.txt gesperrt.
// Worker-Routen: GET /vouchers/check?code=&pin= (Details nur mit PIN), POST /vouchers/redeem { pin, code, note }.
const apiBase = "https://fryhigh-game.fryhigh-bhv.workers.dev";
---
<BaseLayout
  title="Crew · Gutschein-Tool · Fry High"
  description="Gutschein prüfen und einlösen. Crew-intern."
  noindex={true}
>
  <main class="crew">
    <header>
      <span class="eyebrow">Crew-Tool · Pommespilot-Gutschein</span>
      <h1>Gutschein prüfen<br/>und einlösen.</h1>
      <p>Der Gast zeigt den Code aus der Gewinner-Mail (Format <code>FLY-…</code>, 20 Zeichen). Erst <strong>Prüfen</strong>, dann <strong>Einlösen</strong>. Der PIN bleibt in diesem Browser, bis du auf „Abmelden“ tippst.</p>
    </header>

    <section class="card pin-card" data-step="pin">
      <h2>PIN</h2>
      <label>
        <span>Crew-PIN</span>
        <input type="password" id="pin" inputmode="numeric" autocomplete="off" placeholder="••••" required />
      </label>
      <div class="row">
        <button type="button" id="pin-save">PIN speichern</button>
        <button type="button" id="pin-clear" class="ghost">Abmelden</button>
      </div>
      <p class="hint" id="pin-status" aria-live="polite">PIN nicht gesetzt.</p>
    </section>

    <section class="card code-card" data-step="code">
      <h2>Gutschein-Code</h2>
      <label>
        <span>Code aus der Gewinner-Mail</span>
        <input type="text" id="code" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="FLY-…" maxlength="20" required aria-describedby="code-hint" />
      </label>
      <p class="hint" id="code-hint">Format: FLY- plus 16 Zeichen, ohne 0, O, 1 und I.</p>
      <div class="row">
        <button type="button" id="check">Prüfen</button>
        <button type="button" id="reset" class="ghost">Zurücksetzen</button>
      </div>
    </section>

    <section class="card result-card" data-step="result" hidden>
      <h2>Status</h2>
      <div id="result" aria-live="polite"></div>
      <label class="redeem-note" hidden>
        <span>Notiz (optional, z. B. „Rainbow Fritten“)</span>
        <input type="text" id="note" maxlength="120" placeholder="Was wurde ausgesucht?" />
      </label>
      <div class="row">
        <button type="button" id="redeem" class="primary" hidden>Einlösen</button>
      </div>
    </section>

    <footer class="fineprint">
      <p>Endpoint: <code>{apiBase}</code>. Keine Cookies, kein Tracking. PIN nur in <code>localStorage</code> dieses Browsers. Einlösungen werden mit Zeitstempel und Notiz gespeichert.</p>
    </footer>
  </main>
</BaseLayout>

<script define:vars={{ apiBase }}>
  const PIN_KEY = 'fh-crew-pin';
  const $ = (id) => document.getElementById(id);

  const pinInput = $('pin');
  const pinStatus = $('pin-status');
  const codeInput = $('code');
  const resultCard = document.querySelector('[data-step="result"]');
  const resultBox = $('result');
  const redeemBtn = $('redeem');
  const noteWrap = document.querySelector('.redeem-note');
  const noteInput = $('note');

  let lastValidCode = null;

  function readPin() {
    try { return localStorage.getItem(PIN_KEY); } catch { return null; }
  }

  function loadPin() {
    const p = readPin();
    if (p) {
      pinInput.value = p;
      pinStatus.textContent = 'PIN gespeichert (' + p.length + ' Stellen).';
      pinStatus.classList.add('ok');
    } else {
      pinStatus.textContent = 'PIN nicht gesetzt.';
      pinStatus.classList.remove('ok');
    }
  }

  $('pin-save').addEventListener('click', () => {
    const v = pinInput.value.trim();
    if (!v) { pinStatus.textContent = 'Leer.'; return; }
    try { localStorage.setItem(PIN_KEY, v); } catch { pinStatus.textContent = 'Browser speichert nicht. Privatmodus?'; return; }
    loadPin();
  });

  $('pin-clear').addEventListener('click', () => {
    try { localStorage.removeItem(PIN_KEY); } catch {}
    pinInput.value = '';
    loadPin();
  });

  $('reset').addEventListener('click', () => {
    codeInput.value = '';
    resultCard.hidden = true;
    redeemBtn.hidden = true;
    noteWrap.hidden = true;
    noteInput.value = '';
    lastValidCode = null;
    codeInput.focus();
  });

  codeInput.addEventListener('input', () => {
    codeInput.value = codeInput.value.toUpperCase().replace(/[^A-Z0-9-]/g, '');
  });

  function render(state, body) {
    resultCard.hidden = false;
    resultBox.className = 'result-body state-' + state;
    resultBox.innerHTML = body;
  }

  const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const fmtDate = (ms) => new Date(ms).toLocaleDateString('de-DE', { timeZone: 'Europe/Berlin' });
  const fmtDateTime = (ms) => new Date(ms).toLocaleString('de-DE', { timeZone: 'Europe/Berlin' });

  $('check').addEventListener('click', async () => {
    const code = codeInput.value.trim();
    const pin = readPin();
    if (!code) { render('warn', '<p>Kein Code eingegeben.</p>'); return; }
    if (!pin) { render('warn', '<p>PIN fehlt. Oben speichern, sonst zeigt der Worker keine Details.</p>'); return; }
    render('loading', '<p>Prüfe ' + esc(code) + ' …</p>');
    redeemBtn.hidden = true;
    noteWrap.hidden = true;
    try {
      const r = await fetch(apiBase + '/vouchers/check?code=' + encodeURIComponent(code) + '&pin=' + encodeURIComponent(pin));
      const d = await r.json();
      if (d.ok && d.valid) {
        render('ok',
          '<p><strong>Gültig.</strong> ' + esc(d.label || '15-€-Gutschein für Fry High') + '.</p>' +
          '<ul>' +
            '<li>Woche ' + esc(d.week_key) + ' · Score ' + esc(d.score) + '</li>' +
            '<li>Gültig bis ' + fmtDate(d.expires_at) + '</li>' +
            (d.value_eur ? '<li>Warenwert bis ' + esc(d.value_eur) + ' €</li>' : '') +
            '<li>Einlösen: ' + esc(d.redeem_location || 'Fry High im Zoo am Meer') + '</li>' +
          '</ul>'
        );
        redeemBtn.hidden = false;
        noteWrap.hidden = false;
        lastValidCode = code;
      } else if (d.reason === 'redeemed') {
        render('warn', '<p>Schon eingelöst am ' + fmtDateTime(d.redeemed_at) + (d.redeemed_by_note ? ' (' + esc(d.redeemed_by_note) + ')' : '') + '.</p>');
      } else if (d.reason === 'expired') {
        render('err', '<p>Abgelaufen' + (d.expires_at ? ' seit ' + fmtDate(d.expires_at) : '') + '.</p>');
      } else if (d.reason === 'unknown') {
        render('err', '<p>Unbekannter Code. Tippfehler? Kein 0, O, 1 oder I im Code.</p>');
      } else if (d.reason === 'invalid') {
        render('err', '<p>Ungültig oder PIN falsch. PIN oben prüfen und neu speichern.</p>');
      } else {
        render('err', '<p>Fehler: ' + esc(d.error || r.status) + '.</p>');
      }
    } catch (e) {
      render('err', '<p>Netzwerk-Fehler. Nochmal versuchen.</p>');
    }
  });

  redeemBtn.addEventListener('click', async () => {
    const pin = readPin();
    if (!pin) { render('warn', '<p>PIN fehlt. Oben speichern.</p>'); return; }
    if (!lastValidCode) { render('warn', '<p>Erst prüfen.</p>'); return; }
    redeemBtn.disabled = true;
    redeemBtn.textContent = 'Löse ein …';
    try {
      const r = await fetch(apiBase + '/vouchers/redeem', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pin, code: lastValidCode, note: noteInput.value.trim() }),
      });
      const d = await r.json();
      if (d.ok) {
        render('ok', '<p><strong>Eingelöst.</strong> ' + esc(lastValidCode) + ' · ' + fmtDateTime(d.redeemed_at) + '.</p>');
        noteWrap.hidden = true;
        noteInput.value = '';
        lastValidCode = null;
        redeemBtn.hidden = true;
      } else if (r.status === 401) {
        render('err', '<p>PIN falsch. Oben korrigieren und speichern.</p>');
      } else if (r.status === 409) {
        render('warn', '<p>War schon eingelöst' + (d.redeemed_at ? ' am ' + fmtDateTime(d.redeemed_at) : '') + '.</p>');
      } else if (r.status === 410) {
        render('err', '<p>Abgelaufen.</p>');
      } else {
        render('err', '<p>Fehler: ' + esc(d.error || r.status) + '.</p>');
      }
    } catch (e) {
      render('err', '<p>Netzwerk-Fehler. Nochmal.</p>');
    } finally {
      redeemBtn.disabled = false;
      redeemBtn.textContent = 'Einlösen';
    }
  });

  loadPin();
</script>

<style>
  .crew {
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 72px) clamp(20px, 5vw, 40px);
    background: var(--cream);
    min-height: 100vh;
    color: var(--ink);
    font-family: var(--font-body);
  }

  header {
    margin-bottom: 32px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 10px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--navy);
    margin: 0 0 14px;
    letter-spacing: -0.3px;
  }

  header p {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .card {
    background: #fff;
    border: 2px solid var(--navy);
    padding: 20px 22px;
    margin-bottom: 18px;
  }

  .card h2 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--navy);
    margin: 0 0 12px;
  }

  label {
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  label span {
    display: block;
    margin-bottom: 4px;
  }

  input[type="text"], input[type="password"] {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    padding: 10px 12px;
    min-height: 48px;
    border: 1.5px solid var(--navy);
    background: var(--cream-warm);
    color: var(--navy);
    text-transform: none;
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  #code {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 1.25rem;
  }

  .row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  button {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 11px 18px;
    min-height: 48px;
    border: 1.5px solid var(--navy);
    background: var(--navy);
    color: var(--cream);
    cursor: pointer;
  }

  button:hover { background: var(--navy-deep); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  button:disabled { opacity: 0.55; cursor: wait; }

  button.ghost {
    background: transparent;
    color: var(--navy);
  }

  button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--cream);
  }

  button.primary:hover { background: var(--orange-deep); border-color: var(--orange-deep); }

  .hint {
    font-size: 0.8rem;
    margin: 10px 0 0;
    color: var(--ink-soft);
  }

  .card .hint + .row { margin-top: 12px; }

  .hint.ok { color: var(--green); }

  .result-body {
    padding: 14px 16px;
    border-left: 4px solid var(--ink-soft);
    background: var(--cream-warm);
    font-size: 1rem;
    margin-bottom: 14px;
  }

  .result-body p { margin: 0; line-height: 1.5; }
  .result-body ul { margin: 8px 0 0; padding-left: 20px; line-height: 1.5; }
  .result-body.state-ok { border-left-color: var(--green); background: color-mix(in oklab, var(--green) 8%, var(--cream-warm)); }
  .result-body.state-warn { border-left-color: var(--yellow); background: color-mix(in oklab, var(--yellow) 14%, var(--cream-warm)); }
  .result-body.state-err { border-left-color: var(--pink); background: color-mix(in oklab, var(--pink) 8%, var(--cream-warm)); }
  .result-body.state-loading { border-left-color: var(--accent); }

  .fineprint {
    margin-top: 32px;
    font-size: 0.78rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  code {
    font-family: var(--font-mono);
    background: var(--cream-warm);
    padding: 1px 6px;
    font-size: 0.92em;
  }
</style>
