---
// /spiel · Pommespilot. Inhalt aus src/content/spiel.md (P1); ohne die Datei greifen die Defaults.
import { getEntry } from "astro:content";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PilotFlightGame from "../components/PilotFlightGame.astro";
import Leaderboard from "../components/Leaderboard.astro";

interface SpielData {
  name: string;
  contest_live: boolean;
  prize_label: string;
  prize_cap_eur: number;
  redeem_location: string;
  min_age: number;
  valid_days: number;
  teaser_eyebrow: string;
  teaser_headline: string;
  teaser_body: string;
  teaser_cta: string;
}

const DEFAULTS: SpielData = {
  name: "Pommespilot",
  contest_live: false,
  prize_label: "Ein 15-€-Gutschein für Fry High",
  prize_cap_eur: 15,
  redeem_location: "im Zoo am Meer oder am Foodtruck bei öffentlichen Events",
  min_age: 18,
  valid_days: 30,
  teaser_eyebrow: "Pommespilot · Mini-Spiel",
  teaser_headline: "Flieg. Sammel. Schmier nicht ab.",
  teaser_body: "Zutaten einsammeln, Möwen und Ketchup ausweichen, nicht ins Wasser fallen. Ein Tipp reicht.",
  teaser_cta: "Spielen",
};

let spiel: SpielData = DEFAULTS;
try {
  // @ts-ignore Collection „spiel“ kommt aus P1; fehlt sie, bleibt der Fallback.
  const entry = await getEntry("spiel", "spiel");
  if (entry && entry.data) spiel = { ...DEFAULTS, ...(entry.data as Partial<SpielData>) };
} catch {
  spiel = DEFAULTS;
}

const live = spiel.contest_live === true;
const lcFirst = (s: string) => (s ? s.charAt(0).toLowerCase() + s.slice(1) : s);
// Gewinn-Satz an genau einer Stelle gebaut; prize_cap_eur ist intern und bleibt unsichtbar.
const prizeSentence = `Jede Woche gewinnt der höchste berechtigte Score ${lcFirst(spiel.prize_label)}. Bei Gleichstand entscheidet das Los.`;
const TERMS_VERSION = "2026-09-16";

const description = live
  ? `${spiel.name}: Zutaten sammeln, Möwen ausweichen, Wochenwertung. ${prizeSentence}`
  : `${spiel.name}: Zutaten sammeln, Möwen ausweichen, Bestwert knacken. Mit Wochenbestenliste. Die Gewinnrunde ist noch nicht gestartet.`;
---
<MarketingLayout title="Pommespilot · Mini-Spiel · Fry High" description={description}>
  <section class="spiel-hero">
    <div class="spiel-hero-inner">
      <span class="spiel-eyebrow">{live ? "Gewinnspiel · Wochenwertung" : `${spiel.name} · Mini-Spiel`}</span>
      <h1>Flieg. Sammel.<br />Schmier nicht ab.</h1>
      <p class="spiel-lead">Klick, Tipp oder Leertaste hebt. Zutaten sammeln, Möwen ausweichen.</p>
      <a class="fh-link" href="#wochenwertung">Zur Bestenliste ↓</a>
    </div>
  </section>

  <div class="spiel-layout">
    <PilotFlightGame contestLive={live} prizeLabel={prizeSentence} minAge={spiel.min_age} termsVersion={TERMS_VERSION} />
    <Leaderboard contestLive={live} prizeLabel={prizeSentence} />
  </div>

  <section class="spiel-flow">
    <div class="spiel-flow-inner">
      <h2>{live ? "Einmal anmelden. Immer weiterfliegen." : "So läuft die kommende Wochenwertung."}</h2>
      <p>{!live && "Sobald die Wochenwertung startet: "}Name wählen, E-Mail einmal bestätigen. Danach landet dein Score nach jedem Flug automatisch in der Bestenliste. Als Gast kannst du direkt loslegen.</p>
      <p>{live ? prizeSentence + " Nach einem Gewinn kannst du zwölf Monate weiter mitspielen, aber nicht erneut gewinnen." : "Die Gewinnrunde ist noch nicht gestartet. Sobald es losgeht, sagen wir hier Bescheid."}</p>
      <p class="spiel-fineprint">Für die Bestenliste ab {spiel.min_age} Jahren. Öffentlicher Name, private E-Mail. <a class="fh-link" href="/spiel/teilnahmebedingungen">Spielregeln</a> · <a class="fh-link" href="/datenschutz">Datenschutz</a></p>
    </div>
  </section>
</MarketingLayout>

<style>
  .spiel-layout { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr); max-width: 1440px; margin: 0 auto; background: var(--navy-deep); align-items: start; }
  .spiel-layout > :global(*) { min-width: 0; }
  @media (max-width: 1000px) { .spiel-layout { grid-template-columns: 1fr; } }

  .spiel-hero {
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-warm) 100%);
    color: var(--ink);
    padding: 28px 20px 24px;
  }

  .spiel-hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .spiel-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--orange-deep);
    margin-bottom: 12px;
  }

  .spiel-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 0.95;
    margin: 12px 0 18px;
    color: var(--navy);
    text-transform: uppercase;
    letter-spacing: -0.5px;
  }

  .spiel-lead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    margin: 0 auto 22px;
    color: var(--ink);
    max-width: 62ch;
  }

  .spiel-rules-short {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 720px;
    text-align: left;
  }

  .spiel-rules-short li {
    background: var(--cream);
    border: 1.5px solid color-mix(in oklab, var(--ink) 18%, transparent);
    padding: 12px 14px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .spiel-rules-short strong {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange-deep);
    margin-bottom: 4px;
  }

  .spiel-flow {
    background: var(--cream);
    color: var(--ink);
    padding: clamp(48px, 7vw, 84px) clamp(20px, 6vw, 56px);
  }

  .spiel-flow-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .spiel-flow h2 {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    text-transform: uppercase;
    line-height: 1;
    margin: 6px 0 24px;
    color: var(--navy);
    letter-spacing: -0.3px;
  }

  .spiel-flow ol {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    counter-reset: steps;
  }

  .spiel-flow li {
    counter-increment: steps;
    padding: 14px 0 14px 56px;
    position: relative;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    border-bottom: 1px dashed color-mix(in oklab, var(--ink) 18%, transparent);
  }

  .spiel-flow li::before {
    content: counter(steps, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 16px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: var(--orange-deep);
    background: var(--cream-warm);
    border: 1.5px solid var(--orange-deep);
    padding: 6px 10px;
    line-height: 1;
  }

  .spiel-flow li strong {
    font-weight: 600;
    color: var(--navy);
  }

  .spiel-fineprint {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--ink) 72%, transparent);
    margin: 24px 0 0;
  }

  @media (max-width: 720px) {
    .spiel-rules-short { grid-template-columns: 1fr; }
    .spiel-flow li { padding-left: 48px; }
  }
</style>
