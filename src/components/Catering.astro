---
import FloatingMascot from "./FloatingMascot.astro";

interface Props {
  eyebrow: string;
  headline: string;
  intro: string;
  threshold_text: string;
  features: string[];
  response_promise: string;
}

const { eyebrow, headline, intro, threshold_text, features, response_promise } = Astro.props;
const headlineLines = headline.split("\n");
const mailto = `mailto:info@fryhigh.de?subject=${encodeURIComponent("Anfrage für unsere Feier")}&body=${encodeURIComponent("Moin Fry High,\n\nwir planen eine Feier:\nDatum: \nOrt: \nGästezahl: \nAnlass und Wünsche: \n\nViele Grüße")}`;
---
<section id="catering" class="catering has-mascot" aria-labelledby="catering-title">
  <FloatingMascot image="10_Koefte_Feta.png" size={130} rotate={9} top="28px" right="2%" />

  <div class="wrap">
    <div class="copy">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="catering-title">{headlineLines.map((line, i) => (
        <>
          <span class:list={{ acc: i === headlineLines.length - 1 }}>{line}</span>
          {i < headlineLines.length - 1 && <br />}
        </>
      ))}</h2>
      <p class="intro">{intro}</p>
      <p class="threshold">{threshold_text}</p>
      <ul class="features" role="list">
        {features.map((feature) => <li>{feature}</li>)}
      </ul>
      <a class="fh-link detail-link" href="/catering-bremerhaven/">Mehr über unser Catering</a>
    </div>

    <div id="anfrage" class="contact">
      <span class="eyebrow">Eure Anfrage</span>
      <h3>Erzählt uns von eurer Feier.</h3>
      <p>{response_promise}</p>
      <div class="actions">
        <a class="fh-btn" href="https://wa.me/491627500673" target="_blank" rel="noopener">WhatsApp schreiben</a>
        <a class="fh-btn fh-btn--outline" href={mailto}>Per E-Mail anfragen</a>
      </div>
      <a class="email" href={mailto}>info@fryhigh.de</a>
    </div>
  </div>
</section>

<style>
  .catering {
    padding: clamp(56px, 7vw, 88px) clamp(20px, 6vw, 80px);
    background: var(--navy);
    color: var(--cream);
  }
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    max-width: var(--container-wide);
    margin: 0 auto;
  }
  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: inherit;
    margin-bottom: 12px;
  }
  h2, h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1.05;
    margin: 0 0 18px;
    color: inherit;
  }
  h2 { font-size: clamp(2.125rem, 5vw, 3.75rem); }
  h2 .acc { color: var(--orange); }
  h3 { font-size: clamp(1.75rem, 3vw, 2.4rem); }
  p { font-size: 1.1rem; line-height: 1.55; }
  .intro { max-width: 48ch; margin-bottom: 16px; }
  .threshold { font-style: italic; }
  .features {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 20px;
    font-size: 1rem;
  }
  .features li { border-bottom: 1px solid color-mix(in oklab, var(--cream) 35%, transparent); padding-bottom: 4px; }
  .detail-link { margin-top: 24px; line-height: 1.7; }
  .contact { background: var(--cream); color: var(--navy); padding: clamp(24px, 3vw, 36px); }
  .actions { display: grid; gap: 12px; margin: 24px 0 18px; }
  .actions a { text-align: center; justify-content: center; }
  .fh-btn--outline { color: var(--navy); border: 2px solid var(--navy); background: transparent; }
  .fh-btn--outline:hover { color: var(--cream); background: var(--navy); }
  .email { display: inline-block; font-size: 1.05rem; border-bottom: 1px solid currentColor; }
  .email:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  @media (max-width: 800px) {
    .wrap { grid-template-columns: 1fr; }
    .catering :global([data-mascot]) { display: none; }
  }
</style>
