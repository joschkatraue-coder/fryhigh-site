---
// Wochenwertung und Allzeit-Liste („Hall of Pommespiloten“). Rendert nur, wenn die
// Wochenwertung scharf ist (contestLive). Eigener Eintrag wird aus sessionStorage
// (pp_last_entry, gesetzt vom Spiel nach dem Eintragen) hervorgehoben.

interface Props {
  apiBase?: string;
  contestLive?: boolean;
  prizeLabel?: string;
}

const {
  apiBase = "https://fryhigh-game.fryhigh-bhv.workers.dev",
  contestLive = false,
  prizeLabel = "Wer am Sonntag oben steht, bekommt einen 15-€-Gutschein für Fry High.",
} = Astro.props;
---
{contestLive && (
  <section class="leaderboard" id="wochenwertung" data-api-base={apiBase} data-prize={prizeLabel} aria-labelledby="lb-title">
    <div class="lb-head">
      <div class="lb-eyebrow" data-lb-eyebrow>Diese Woche · Top 10</div>
      <h2 id="lb-title" data-lb-title>Wochenwertung.</h2>
      <p data-lb-sub>{prizeLabel} Montag früh geht es wieder bei null los.</p>
    </div>

    <div class="lb-tabs" role="tablist" aria-label="Zeitraum">
      <button type="button" class="lb-tab is-active" data-period="week" role="tab" aria-selected="true">Diese Woche</button>
      <button type="button" class="lb-tab" data-period="all" role="tab" aria-selected="false">Allzeit</button>
    </div>

    <ol class="lb-list" data-lb-list>
      <li class="lb-empty" data-lb-empty>Noch keine bestätigten Scores diese Woche. Mach den Anfang.</li>
    </ol>

    <div class="lb-meta">
      <span data-lb-week>–</span>
      <button type="button" class="lb-refresh" data-lb-refresh>Aktualisieren</button>
    </div>
  </section>
)}

<script>
  const SECTION = document.querySelector<HTMLElement>('.leaderboard');
  if (SECTION) {
    const apiBase = SECTION.dataset.apiBase ?? '';
    const prize = SECTION.dataset.prize ?? '';
    const list = SECTION.querySelector<HTMLOListElement>('[data-lb-list]')!;
    const empty = SECTION.querySelector<HTMLElement>('[data-lb-empty]')!;
    const weekEl = SECTION.querySelector<HTMLElement>('[data-lb-week]')!;
    const refreshBtn = SECTION.querySelector<HTMLButtonElement>('[data-lb-refresh]')!;
    const eyebrowEl = SECTION.querySelector<HTMLElement>('[data-lb-eyebrow]')!;
    const titleEl = SECTION.querySelector<HTMLElement>('[data-lb-title]')!;
    const subEl = SECTION.querySelector<HTMLElement>('[data-lb-sub]')!;
    const tabs = SECTION.querySelectorAll<HTMLButtonElement>('.lb-tab');

    let currentPeriod: 'week' | 'all' = 'week';
    let lbController: AbortController | null = null; // laufenden Abruf beim Tab-Wechsel abbrechen

    interface Entry { rank: number; name: string; score: number }
    interface Resp { period: 'week' | 'all'; week_key: string | null; top: Entry[] }

    const labels = {
      week: {
        eyebrow: 'Diese Woche · Top 10',
        title: 'Wochenwertung.',
        sub: `${prize} Montag früh geht es wieder bei null los.`.trim(),
        empty: 'Noch keine bestätigten Scores diese Woche. Mach den Anfang.',
      },
      all: {
        eyebrow: 'Allzeit · Top 10',
        title: 'Hall of Pommespiloten.',
        sub: 'Beste Scores aller Wochen. Mehrere Versuche zählen, es bleibt der höchste.',
        empty: 'Noch keine bestätigten Scores. Flieg die erste Runde.',
      },
    };

    function applyLabels() {
      const l = labels[currentPeriod];
      eyebrowEl.textContent = l.eyebrow;
      titleEl.textContent = l.title;
      subEl.textContent = l.sub;
      empty.textContent = l.empty;
    }

    function ownEntry(): { name: string; score: number } | null {
      try {
        const raw = sessionStorage.getItem('pp_last_entry');
        if (!raw) return null;
        const parsed = JSON.parse(raw) as { name?: unknown; score?: unknown };
        const score = Math.floor(Number(parsed.score));
        if (!Number.isFinite(score)) return null;
        return { name: String(parsed.name ?? '').trim(), score };
      } catch {
        return null;
      }
    }

    function isMine(entry: Entry, mine: { name: string; score: number } | null, scoreNum: number, alreadyMarked: boolean) {
      if (!mine || alreadyMarked || scoreNum !== mine.score) return false;
      const name = String(entry.name ?? '').trim();
      if (mine.name) return name.localeCompare(mine.name, 'de', { sensitivity: 'base' }) === 0;
      return true; // ohne Spitznamen: Worker zeigt „Pilot #…“, nur der Score passt
    }

    async function load() {
      if (!apiBase) return;
      if (lbController) lbController.abort();
      const controller = new AbortController();
      lbController = controller;
      const signal = controller.signal;
      refreshBtn.disabled = true;
      try {
        const url = currentPeriod === 'all'
          ? `${apiBase}/leaderboard?period=all`
          : `${apiBase}/leaderboard`;
        const res = await fetch(url, { cache: 'no-store', signal });
        if (lbController !== controller) return;
        if (!res.ok) throw new Error('lb fetch failed');
        const data = (await res.json()) as Resp;
        if (lbController !== controller) return;
        weekEl.textContent = data.period === 'all'
          ? 'Allzeit'
          : `Woche ${data.week_key ?? '–'}`;
        list.replaceChildren();
        if (!data.top || data.top.length === 0) {
          list.appendChild(empty);
          return;
        }
        const mine = currentPeriod === 'week' ? ownEntry() : null;
        let marked = false;
        for (const entry of data.top) {
          const rankNum = Math.floor(Number(entry.rank) || 0);
          const scoreNum = Math.floor(Number(entry.score) || 0);
          const li = document.createElement('li');
          li.className = 'lb-item';
          const rankSpan = document.createElement('span');
          rankSpan.className = 'lb-rank';
          rankSpan.textContent = String(rankNum).padStart(2, '0');
          const nameSpan = document.createElement('span');
          nameSpan.className = 'lb-name';
          nameSpan.textContent = String(entry.name ?? '');
          const scoreSpan = document.createElement('span');
          scoreSpan.className = 'lb-score';
          scoreSpan.textContent = String(scoreNum);
          li.append(rankSpan, nameSpan, scoreSpan);
          if (rankNum === 1) li.classList.add('lb-item--top');
          if (isMine(entry, mine, scoreNum, marked)) {
            marked = true;
            li.classList.add('lb-item--me');
            const tag = document.createElement('span');
            tag.className = 'lb-me';
            tag.textContent = 'du';
            nameSpan.append(' ', tag);
          }
          list.appendChild(li);
        }
      } catch (e) {
        if ((e as Error).name === 'AbortError') return;
        if (lbController !== controller) return;
        console.warn('leaderboard load failed', e);
        weekEl.textContent = 'Wochenwertung gerade nicht erreichbar';
      } finally {
        if (lbController === controller) refreshBtn.disabled = false;
      }
    }

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = (btn.dataset.period as 'week' | 'all') ?? 'week';
        if (next === currentPeriod) return;
        currentPeriod = next;
        tabs.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        applyLabels();
        load();
      });
    });

    refreshBtn.addEventListener('click', load);
    window.addEventListener('leaderboard:refresh', load);
    load();
  }
</script>

<style>
  .leaderboard {
    background: var(--navy);
    color: var(--cream);
    padding: clamp(48px, 7vw, 84px) clamp(20px, 6vw, 56px);
  }

  .lb-head {
    max-width: 540px;
    margin: 0 auto 24px;
    text-align: center;
  }

  .lb-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 8px;
  }

  .lb-head h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 12px;
    letter-spacing: -0.5px;
    color: var(--cream);
  }

  .lb-head p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: color-mix(in oklab, var(--cream) 82%, transparent);
    margin: 0;
  }

  .lb-tabs {
    max-width: 540px;
    margin: 0 auto 16px;
    display: flex;
    gap: 0;
    border: 1.5px solid color-mix(in oklab, var(--cream) 30%, transparent);
  }

  .lb-tab {
    flex: 1;
    background: transparent;
    color: color-mix(in oklab, var(--cream) 72%, transparent);
    border: 0;
    padding: 12px 14px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .lb-tab + .lb-tab {
    border-left: 1.5px solid color-mix(in oklab, var(--cream) 30%, transparent);
  }

  .lb-tab:hover:not(.is-active) { color: var(--yellow); }

  .lb-tab:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: -3px;
  }

  .lb-tab.is-active {
    background: var(--cream);
    color: var(--navy);
    border-bottom: 2px solid var(--accent);
  }

  .lb-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 540px;
    border-top: 1px dashed color-mix(in oklab, var(--cream) 30%, transparent);
  }

  .lb-item {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 14px;
    align-items: baseline;
    padding: 14px 8px;
    border-bottom: 1px dashed color-mix(in oklab, var(--cream) 20%, transparent);
  }

  .lb-rank {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    color: color-mix(in oklab, var(--cream) 65%, transparent);
  }

  .lb-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--cream);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .lb-score {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--cream);
    line-height: 1;
  }

  .lb-item--top {
    background: linear-gradient(90deg, transparent 0%, color-mix(in oklab, var(--yellow) 18%, transparent) 60%, transparent 100%);
  }

  .lb-item--top .lb-rank,
  .lb-item--top .lb-name,
  .lb-item--top .lb-score { color: var(--yellow); }

  .lb-item--me {
    background: color-mix(in oklab, var(--orange) 16%, transparent);
    box-shadow: inset 4px 0 0 var(--orange);
  }

  .lb-me {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--orange);
    color: var(--cream);
    padding: 2px 6px;
    vertical-align: middle;
  }

  .lb-empty {
    text-align: center;
    padding: 32px 0;
    font-family: var(--font-body);
    font-style: italic;
    color: color-mix(in oklab, var(--cream) 72%, transparent);
    list-style: none;
    border-bottom: 1px dashed color-mix(in oklab, var(--cream) 20%, transparent);
  }

  .lb-meta {
    max-width: 540px;
    margin: 18px auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: color-mix(in oklab, var(--cream) 65%, transparent);
    text-transform: uppercase;
  }

  .lb-refresh {
    background: transparent;
    color: var(--cream);
    border: 1.5px solid color-mix(in oklab, var(--cream) 40%, transparent);
    padding: 8px 14px;
    min-height: 40px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .lb-refresh:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .lb-refresh:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }

  .lb-refresh:disabled { opacity: 0.5; cursor: default; }
</style>
