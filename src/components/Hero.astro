---
import { Picture } from "astro:assets";
import FloatingMascot from "./FloatingMascot.astro";
import loadedFries from "../assets/hero/loaded-fries-hero.jpg";

interface HeadlinePart {
  text: string;
  accent?: boolean;
}

interface CTA {
  label: string;
  href: string;
  style: "primary" | "secondary";
}

interface Props {
  eyebrow: string;
  headline_lines: (string | HeadlinePart)[];
  lead: string;
  ctas: CTA[];
}

const { eyebrow, headline_lines, lead, ctas } = Astro.props;

const normalizedLines = headline_lines.map((line) =>
  typeof line === "string" ? { text: line, accent: false } : { accent: false, ...line }
);
---
<section class="hero has-mascot">
  <FloatingMascot
    image="02_Tropical_Drachenfrucht.png"
    size={180}
    rotate={-8}
    top="22%"
    right="8%"
    z={2}
  />
  <div class="hero-photo" aria-hidden="true">
    <Picture
      src={loadedFries}
      alt=""
      widths={[640, 1280, 1920, 2560]}
      sizes="100vw"
      formats={["avif", "webp"]}
      quality={82}
      loading="eager"
      fetchpriority="high"
    />
    <div class="overlay"></div>
  </div>
  <div class="hero-content">
    <span class="eyebrow">{eyebrow}</span>
    <h1>
      {normalizedLines.map((line, i) => (
        <>
          <span class:list={[{ accent: line.accent }]}>{line.text}</span>
          {i < normalizedLines.length - 1 && <br />}
        </>
      ))}
    </h1>
    <p class="lead">{lead}</p>
    <div class="ctas">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class:list={["btn", `btn-${cta.style}`]}
        >
          {cta.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    color: var(--cream);
    padding: 60px clamp(20px, 6vw, 80px);
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-photo :global(img),
  .hero-photo :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--navy-deep) 6%, transparent) 0%,
      color-mix(in oklab, var(--navy-deep) 85%, transparent) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
    padding-bottom: 60px;
    display: grid;
    gap: var(--space-4);
  }

  .eyebrow {
    display: inline-block;
    background: var(--accent);
    color: var(--cream);
    padding: 5px 11px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    justify-self: start;
    margin-bottom: 6px;
  }

  h1 {
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.875rem);
    line-height: 0.98;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    margin: 0;
  }

  h1 .accent {
    color: var(--accent);
  }

  .lead {
    color: var(--cream);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-style: italic;
    max-width: 580px;
    line-height: 1.55;
    opacity: 0.95;
  }

  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 3px;
    transition: transform var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--cream);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    background: color-mix(in oklab, var(--accent) 88%, black);
  }

  .btn-secondary {
    background: transparent;
    color: var(--cream);
    border: 2px solid var(--cream);
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    background: var(--cream);
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .hero { min-height: 76vh; padding: 40px clamp(16px, 5vw, 32px); }
    .hero-content { padding-bottom: 40px; }
  }
</style>
