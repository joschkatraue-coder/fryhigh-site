---
/* Hero. Inhalte aus src/content/home.md (`hero`): Eyebrow, dreizeilige Headline, Lead,
   Ortszeile (Mono) und zwei CTAs (.fh-btn / .fh-btn--ghost). Page-Reveal-Stagger per CSS
   (CI v1 §8.1/§8.2: 600 ms gesamt, 60 ms Stagger; reduced-motion: Snap). Mascot nur ab
   1024 px, rechts unten außerhalb der Textspalte. Kein Stamp im Cream-Container (CI §7.3):
   02-stamp-flat.svg ist ein Scaffold, dessen Bogentext im Browser mit dem SINCE-2020-Banner
   kollidiert (Render-Test 2026-09-11); nachziehen, sobald die finale Marke vorliegt. */
import { Picture } from "astro:assets";
import FloatingMascot from "./FloatingMascot.astro";
import loadedFries from "../assets/hero/loaded-fries-hero.jpg";

interface HeadlinePart {
  text: string;
  accent?: boolean;
}

interface CTA {
  label: string;
  href: string;
  style: "primary" | "secondary";
}

interface Props {
  eyebrow: string;
  headline_lines: (string | HeadlinePart)[];
  lead: string;
  location_line?: string;
  ctas: CTA[];
}

const { eyebrow, headline_lines, lead, location_line, ctas } = Astro.props;

const normalizedLines = headline_lines.map((line) =>
  typeof line === "string" ? { text: line, accent: false } : { accent: false, ...line }
);
---
<section class="hero has-mascot" aria-labelledby="hero-title">
  <FloatingMascot
    image="02_Tropical_Drachenfrucht.png"
    size={180}
    rotate={-8}
    bottom="9%"
    right="5%"
    z={2}
  />

  <div class="hero-photo" aria-hidden="true">
    <Picture
      src={loadedFries}
      alt=""
      widths={[640, 1280, 1920, 2560, 3840]}
      sizes="100vw"
      formats={["avif", "webp"]}
      quality={82}
      loading="eager"
      fetchpriority="high"
    />
    <div class="overlay"></div>
  </div>

  <div class="hero-content">
    <span class="eyebrow reveal" style="--i:0">{eyebrow}</span>
    <h1 id="hero-title" class="reveal" style="--i:1">
      {normalizedLines.map((line, i) => (
        <>
          <span class:list={[{ accent: line.accent }]}>{line.text}</span>
          {i < normalizedLines.length - 1 && <br />}
        </>
      ))}
    </h1>
    <p class="lead reveal" style="--i:2">{lead}</p>
    {location_line && <p class="location reveal" style="--i:3">{location_line}</p>}
    <div class="ctas reveal" style="--i:4">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class:list={["fh-btn", { "fh-btn--ghost": cta.style === "secondary" }]}
        >
          {cta.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    color: var(--cream);
    padding: 60px clamp(20px, 6vw, 80px);
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-photo :global(img),
  .hero-photo :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--navy-deep) 6%, transparent) 0%,
      color-mix(in oklab, var(--navy-deep) 85%, transparent) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 880px;
    padding-bottom: 60px;
    display: grid;
    gap: var(--space-4);
  }

  .eyebrow {
    display: inline-block;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 1;
    margin-bottom: 2px;
  }

  h1 {
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.875rem);
    line-height: 0.98;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    margin: 0;
  }

  h1 .accent {
    color: var(--orange);
  }

  .lead {
    color: var(--cream);
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-style: italic;
    max-width: 580px;
    line-height: 1.55;
    opacity: 0.95;
  }

  .location {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: var(--cream);
    opacity: 0.9;
    max-width: 580px;
  }

  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  /* Page-Reveal: 5 Gruppen à 360 ms, 60 ms Stagger → 600 ms gesamt (CI v1 §8.2). */
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    animation: hero-reveal 360ms var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms);
  }

  @keyframes hero-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Mascot nur ab 1024 px: darunter reicht der Platz rechts neben der Textspalte nicht. */
  @media (max-width: 1023px) {
    .hero > :global(.mascot) {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 76vh;
      padding: 40px clamp(16px, 5vw, 32px);
    }

    .hero-content {
      padding-bottom: 40px;
    }

    .eyebrow,
    .location {
      font-size: var(--t-mono-min);
    }
  }
</style>
