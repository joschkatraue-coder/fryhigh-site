---
import { Picture } from "astro:assets";
import loadedFries from "../assets/hero/loaded-fries-hero.jpg";

interface HeadlinePart {
  text: string;
  accent?: boolean;
}

interface CTA {
  label: string;
  href: string;
  style: "primary" | "secondary";
}

interface Props {
  eyebrow: string;
  headline_lines: (string | HeadlinePart)[];
  lead: string;
  ctas: CTA[];
}

const { eyebrow, headline_lines, lead, ctas } = Astro.props;

const normalizedLines = headline_lines.map((line) =>
  typeof line === "string" ? { text: line, accent: false } : { accent: false, ...line }
);
---
<section class="hero">
  <div class="hero-photo">
    <Picture
      src={loadedFries}
      alt="Loaded Fries Kreation auf dem Tresen"
      widths={[480, 960, 1440, 1920]}
      sizes="(min-width: 1100px) 50vw, 100vw"
      formats={["avif", "webp"]}
      quality={82}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-content">
    <span class="eyebrow">{eyebrow}</span>
    <h1>
      {normalizedLines.map((line, i) => (
        <>
          <span class:list={[{ accent: line.accent }]}>{line.text}</span>
          {i < normalizedLines.length - 1 && <br />}
        </>
      ))}
    </h1>
    <p class="lead">{lead}</p>
    <div class="ctas">
      {ctas.map((cta) => (
        <a
          href={cta.href}
          class:list={["btn", `btn-${cta.style}`]}
        >
          {cta.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: 78vh;
    background: var(--bg);
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
    background: var(--bg-deep);
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-content {
    display: grid;
    align-content: center;
    gap: var(--space-5);
    padding: var(--space-10) var(--space-7);
    max-width: 720px;
  }

  h1 {
    color: var(--ink);
  }

  h1 .accent {
    color: var(--accent);
  }

  .ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .btn {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--r-md);
    transition: transform var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--cream);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    background: color-mix(in oklab, var(--accent) 88%, black);
  }

  .btn-secondary {
    background: transparent;
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    background: var(--ink);
    color: var(--cream);
  }

  @media (max-width: 980px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-photo { aspect-ratio: 4 / 3; }
    .hero-content { padding: var(--space-8) var(--space-5); max-width: none; }
  }
</style>
