---
/* Standort & Zeiten (#standorte). Zoo-Karte groß mit Foto, Adresse, Saison, Zugang, Route und
   WhatsApp; Foodtruck-Karte schmal mit Link auf #catering. Texte: copy-master.md §4,
   Karteninhalte aus src/content/standorte/*.md. */
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import StandortCard from "./StandortCard.astro";
import FloatingMascot from "./FloatingMascot.astro";

interface Props {
  standorte: CollectionEntry<"standorte">[];
}

const { standorte } = Astro.props;
const sorted = [...standorte].sort((a, b) => a.data.order - b.data.order);

// Fotos liegen in src/assets/photos/; das Content-Feld `photo` nennt sie als "photos/<datei>".
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const resolvePhoto = (photo?: string): ImageMetadata | undefined => {
  if (!photo) return undefined;
  const key = `../assets/${photo.replace(/^\/?(src\/)?assets\//, "")}`;
  return photoModules[key]?.default;
};

// Fokuspunkte für den Cover-Zuschnitt (analyse/08-fotos.md §3).
const photoFocus: Record<string, string> = {
  "photos/hochterrasse.jpg": "50% 58%",
  "photos/terrasse-weserblick.jpg": "50% 50%",
  "photos/terrasse-sail-city.jpg": "50% 50%",
};

// Öffentliche Nummer nur per WhatsApp (F10, Joschka 2026-09-11): kein tel:-Link.
// Das Content-Feld `phone` trägt noch die Default-Nummer und wird deshalb hier nicht gerendert.
const WHATSAPP = {
  label: "WhatsApp: 0160 96 47 78 23",
  href: "https://wa.me/4916096477823",
  aria: "Fry High per WhatsApp schreiben",
};
---
<section class="standorte has-mascot" id="standorte" aria-labelledby="standorte-title">
  <FloatingMascot
    image="08_Seehund_Fries_Garnelen.png"
    size={150}
    rotate={-12}
    top="48px"
    right="3%"
  />
  <FloatingMascot
    image="13_Nordsee_Fries_Gruenkohl.png"
    size={120}
    rotate={7}
    bottom="40px"
    right="4%"
  />

  <div class="inner">
    <div class="head">
      <span class="eyebrow">Standort &amp; Zeiten</span>
      <h2 id="standorte-title">Wo wir sind. Wann wir auf haben.</h2>
      <p class="lead">Ein Restaurant im Zoo am Meer und ein Foodtruck, der zu euch kommt.</p>
    </div>

    <div class="grid">
      {sorted.map((entry, i) => {
        const isTruck = entry.data.slug === "food-truck";
        const isPrimary = i === 0;
        const photo = resolvePhoto(entry.data.photo);
        return (
          <StandortCard
            size={isPrimary ? "large" : "small"}
            weg={entry.data.gate}
            weg_subtitle={entry.data.gate_subtitle}
            name={entry.data.name}
            address={entry.data.address}
            hours_line={entry.data.hours_line}
            access_line={entry.data.access_line}
            route_url={entry.data.route_url}
            contact_label={entry.data.address ? WHATSAPP.label : undefined}
            contact_href={entry.data.address ? WHATSAPP.href : undefined}
            contact_aria={entry.data.address ? WHATSAPP.aria : undefined}
            photo={photo}
            photo_alt={entry.data.photo_alt}
            photo_position={entry.data.photo ? photoFocus[entry.data.photo] : undefined}
            description={entry.data.description}
            modes={entry.data.modes}
            status={entry.data.status}
            link_href={isTruck ? "#catering" : undefined}
            link_label={isTruck ? "Zum Catering →" : undefined}
          />
        );
      })}
    </div>
  </div>
</section>

<style>
  .standorte {
    background: var(--cream);
    padding: var(--space-7) clamp(20px, 5vw, 64px);
  }

  .inner {
    max-width: var(--container-grid);
    margin: 0 auto;
    display: grid;
    gap: var(--space-6);
  }

  .head {
    display: grid;
    gap: var(--space-3);
    max-width: 760px;
  }

  .head h2 {
    color: var(--navy);
  }

  .head .lead {
    color: var(--ink-soft);
    margin-top: var(--space-2);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  /* Mascots erst ab 1024 px: darunter reicht der Platz neben der Überschrift nicht. */
  @media (max-width: 1023px) {
    .standorte > :global(.mascot) {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .standorte {
      padding: var(--space-6) 20px;
    }

    .inner {
      gap: var(--space-5);
    }
  }
</style>
