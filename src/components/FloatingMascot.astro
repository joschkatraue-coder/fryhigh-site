---
/* Floating Mascot — Loaded-Fries-Cutout am Sektionsrand.
   Seit 2026-09-11 position:absolute innerhalb der .has-mascot-Sektion (Design-Audit §2.1):
   Cutouts scrollen mit ihrer Sektion und können keine Nachbarsektion überlagern.
   Positionen gehören an die Ränder außerhalb der Textspalte; ein Mascot darf nie Text überdecken.
   Mobil (≤ 720 px) ist ein Mascot standardmäßig ausgeblendet (mobile="hide");
   mobile="show" zeigt es mit höchstens 90 px. Reveal läuft weiter über den
   IntersectionObserver in scripts/mascot.ts (.in-view auf der Sektion). */
interface Props {
  image: string;                 // Dateiname in public/cutouts/
  size?: number;                 // px auf Desktop, default 130
  rotate?: number;               // Grundrotation in Grad
  top?: string;                  // CSS-Wert, z. B. "8%" oder "-24px"
  bottom?: string;
  left?: string;
  right?: string;
  z?: number;                    // z-index, default 2
  mobile?: "hide" | "show";      // default "hide"
  alt?: string;
}

const {
  image,
  size = 130,
  rotate = 0,
  top,
  bottom,
  left,
  right,
  z = 2,
  mobile = "hide",
  alt = "",
} = Astro.props;

const mobileSize = Math.min(90, Math.round(size * 0.6));

const positionStyle = [
  top !== undefined && `top:${top}`,
  bottom !== undefined && `bottom:${bottom}`,
  left !== undefined && `left:${left}`,
  right !== undefined && `right:${right}`,
  `--mascot-size:${size}px`,
  `--mascot-size-mobile:${mobileSize}px`,
  `--mascot-base-rotate:${rotate}deg`,
  `z-index:${z}`,
].filter(Boolean).join(";");
---
<div class="mascot" data-mascot data-mobile={mobile} style={positionStyle} aria-hidden="true">
  <img src={`/cutouts/${image}`} alt={alt} loading="lazy" decoding="async" />
</div>

<style>
  .mascot {
    position: absolute;
    width: var(--mascot-size, 130px);
    height: var(--mascot-size, 130px);
    pointer-events: none;
    opacity: 0;
    --reveal-translate: 12px;
    transform:
      translate(0, var(--reveal-translate))
      rotate(var(--mascot-base-rotate, 0deg));
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .mascot.in-view {
    opacity: 1;
    --reveal-translate: 0px;
  }

  .mascot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter:
      drop-shadow(2px 2px 0 white)
      drop-shadow(-2px -2px 0 white)
      drop-shadow(2px -2px 0 white)
      drop-shadow(-2px 2px 0 white)
      drop-shadow(0 12px 24px color-mix(in oklab, black 35%, transparent));
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Grünkohl-Cutout: weiße Outlines weglassen (Rembg-Artefakte am Tray). */
  .mascot img[src*="13_Nordsee_Fries_Gruenkohl"] {
    filter: drop-shadow(0 12px 24px color-mix(in oklab, black 35%, transparent));
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot {
      --reveal-translate: 0px;
      transition: opacity var(--duration-slow) ease;
    }
  }

  @media (max-width: 720px) {
    .mascot {
      width: var(--mascot-size-mobile, 78px);
      height: var(--mascot-size-mobile, 78px);
    }

    .mascot[data-mobile="hide"] {
      display: none;
    }
  }
</style>
