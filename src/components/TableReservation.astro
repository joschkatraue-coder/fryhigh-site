---
import FloatingMascot from "./FloatingMascot.astro";

interface Zone { value: string; label: string; }
interface FormCfg {
  submit_endpoint: string;
  pax_min: number;
  pax_max: number;
  booking_weeks: number;
  default_time: string;
  zones: Zone[];
  occasions: string[];
}
interface Props {
  eyebrow: string;
  headline: string;
  intro: string;
  features: string[];
  form: FormCfg;
}

const { eyebrow, headline, intro, features, form } = Astro.props;
const headlineLines = headline.split("\n");

// Datumsgrenzen werden im Browser gesetzt (Script unten), nicht beim Build.
// Default-Pax 2: häufigster Fall, Designentscheidung.
const paxDefault = 2;

// F18 (Joschka): keine Bereichswahl, stattdessen ein Textfeld "Wunschort".
// Die Zonen aus tisch.md dienen nur noch als Beispiel im Placeholder; der Worker
// liest das Feld "zone" weiterhin (Freitext, 32 Zeichen).
const zoneExamples = form.zones
  .filter((z) => z.value !== "egal")
  .map((z) => z.label);
const zonePlaceholder = zoneExamples.length > 0
  ? `z. B. ${zoneExamples.join(" oder ")}`
  : "z. B. Hochterrasse oder innen";
---
<section id="tisch" class="tisch has-mascot">
  <FloatingMascot
    image="05_Kapitaens_Fries_Schnitzel.png"
    size={130}
    rotate={-7}
    top="28px"
    right="2%"
  />

  <div class="wrap">
    <div class="copy">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{headlineLines.map((line, i) => (
        <>
          <span class:list={{ acc: i === headlineLines.length - 1 && headlineLines.length > 1 }}>{line}</span>
          {i < headlineLines.length - 1 && <br />}
        </>
      ))}</h2>
      <p class="intro">{intro}</p>
      <ul class="feat" role="list">
        {features.map((f) => (
          <li>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="form-col">
      <form
        class="fp"
        action={form.submit_endpoint}
        method="post"
        data-table-form
        data-booking-weeks={form.booking_weeks}
      >
        <div class="fp-header">
          <div class="fp-stamp" aria-hidden="true">FH</div>
          <div>
            <div class="fp-title">Tischanfrage</div>
            <div class="fp-sub">Die Crew bestätigt per Mail.</div>
          </div>
        </div>

        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="fp-honey" aria-hidden="true" />

        <div class="fp-section">
          <div class="fp-section-title">
            <span>Kontakt</span>
            <span class="hint">Wer bist du?</span>
          </div>
          <div class="fp-row">
            <label class="fp-field">
              <span class="fp-field-label">Name</span>
              <input type="text" name="name" placeholder="Dein Name" required autocomplete="name" />
            </label>
            <label class="fp-field">
              <span class="fp-field-label">E-Mail</span>
              <input type="email" name="email" placeholder="deine@mail.de" required autocomplete="email" />
            </label>
          </div>
          <div class="fp-row fp-row--single">
            <label class="fp-field">
              <span class="fp-field-label">Telefon (optional)</span>
              <input type="tel" name="phone" placeholder="Für Rückfragen" autocomplete="tel" />
            </label>
          </div>
        </div>

        <div class="fp-section">
          <div class="fp-section-title">
            <span>Wann und wie viele</span>
            <span class="hint">Bis {form.booking_weeks} Wochen im Voraus</span>
          </div>
          <div class="fp-row">
            <label class="fp-field">
              <span class="fp-field-label">Datum</span>
              <input type="date" name="date" required data-date-range />
            </label>
            <label class="fp-field">
              <span class="fp-field-label">Uhrzeit</span>
              <input type="time" name="time" required value={form.default_time} step="900" />
            </label>
          </div>
          <div class="fp-row fp-row--single">
            <div class="fp-field fp-range-wrap">
              <span class="fp-field-label">Personen</span>
              <div class="fp-range-row">
                <div class="n"><output data-pax-out>{paxDefault}</output><small>Personen</small></div>
              </div>
              <input
                type="range"
                name="pax"
                aria-label="Personen"
                min={form.pax_min}
                max={form.pax_max}
                step="1"
                value={paxDefault}
                class="fp-range"
                data-pax-range
              />
              <div class="fp-range-readout" data-pax-readout>Tisch für zwei</div>
            </div>
          </div>
        </div>

        <div class="fp-section">
          <div class="fp-section-title">
            <span>Wunschort</span>
            <span class="hint">Wo am liebsten?</span>
          </div>
          <div class="fp-row fp-row--single">
            <label class="fp-field">
              <span class="fp-field-label">Wunschort</span>
              <input type="text" name="zone" placeholder={zonePlaceholder} maxlength="32" autocomplete="off" />
            </label>
          </div>
        </div>

        <div class="fp-section">
          <div class="fp-section-title">
            <span>Anlass</span>
            <span class="hint">Was feierst du?</span>
          </div>
          <div class="fp-occasions" role="group" aria-label="Anlass">
            {form.occasions.map((occ) => (
              <button
                type="button"
                class="fp-occ"
                data-occasion={occ}
                aria-pressed="false"
              >{occ}</button>
            ))}
          </div>
          <input type="hidden" name="occasion" value="" data-occasion-input />

          <textarea
            class="fp-text"
            name="notes"
            placeholder="Allergien, Hochstuhl, Name vom Geburtstagskind? Hier rein."
          ></textarea>
        </div>

        <div class="fp-section fp-section--submit">
          <button type="submit" class="fh-btn fp-submit" data-submit>
            <span>Tisch anfragen</span>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <p class="fp-meta">Wir bestätigen per Mail.</p>
          <p class="fp-status" role="status" aria-live="polite" data-status></p>

          <div class="fp-fallback" data-fallback hidden>
            <p>Hm, das hat nicht geklappt. Schreib uns kurz an <a class="fh-link" href="mailto:info@fryhigh.de?subject=Tischanfrage">info@fryhigh.de</a></p>
            <a class="fh-btn" href="mailto:info@fryhigh.de?subject=Tischanfrage" data-mailto>Als Mail senden</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Tisch-Formular: Datumsgrenzen im Browser, Slider-Readout, Anlass-Pills, Submit mit Mail-Fallback.
  const tierFor = (pax: number): string => {
    if (pax <= 1) return "Für dich allein";
    if (pax === 2) return "Tisch für zwei";
    if (pax <= 4)  return "Kleine Runde";
    if (pax <= 8)  return "Größere Runde";
    return "Lange Tafel";
  };

  const pad = (n: number) => String(n).padStart(2, "0");
  const localIso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

  const forms = Array.from(document.querySelectorAll<HTMLFormElement>("[data-table-form]"));

  const selectOccasion = (form: HTMLFormElement, value: string): boolean => {
    const target = Array.from(form.querySelectorAll<HTMLButtonElement>(".fp-occ"))
      .find((b) => b.dataset.occasion === value);
    if (!target) return false;
    if (!target.classList.contains("active")) target.click();
    return true;
  };

  const mailtoHref = (form: HTMLFormElement): string => {
    const fd = new FormData(form);
    const v = (k: string) => String(fd.get(k) ?? "").trim();
    const lines = [
      `Name: ${v("name")}`,
      `E-Mail: ${v("email")}`,
      `Telefon: ${v("phone")}`,
      `Datum: ${v("date")}`,
      `Uhrzeit: ${v("time")}`,
      `Personen: ${v("pax")}`,
      `Wunschort: ${v("zone")}`,
      `Anlass: ${v("occasion")}`,
      "",
      "Notiz:",
      v("notes"),
    ];
    return `mailto:info@fryhigh.de?subject=${encodeURIComponent("Tischanfrage")}&body=${encodeURIComponent(lines.join("\n"))}`;
  };

  forms.forEach((form) => {
    // Datum: heute bis heute plus booking_weeks Wochen, im Browser gerechnet.
    const weeks = Number(form.dataset.bookingWeeks ?? "8");
    form.querySelectorAll<HTMLInputElement>("[data-date-range]").forEach((d) => {
      const today = new Date();
      const max = new Date(today);
      max.setDate(max.getDate() + weeks * 7);
      d.min = localIso(today);
      d.max = localIso(max);
    });

    const range = form.querySelector<HTMLInputElement>("[data-pax-range]");
    const out = form.querySelector<HTMLOutputElement>("[data-pax-out]");
    const readout = form.querySelector<HTMLElement>("[data-pax-readout]");
    const updatePax = () => {
      if (!range || !out || !readout) return;
      const v = Number(range.value);
      out.textContent = String(v);
      readout.textContent = tierFor(v);
      const min = Number(range.min);
      const max = Number(range.max);
      const pct = max > min ? ((v - min) / (max - min)) * 100 : 0;
      range.style.setProperty("--pax-pct", `${pct}%`);
    };
    range?.addEventListener("input", updatePax);
    updatePax();

    const occBtns = form.querySelectorAll<HTMLButtonElement>(".fp-occ");
    const occInput = form.querySelector<HTMLInputElement>("[data-occasion-input]");
    occBtns.forEach((b) => b.addEventListener("click", () => {
      const wasActive = b.classList.contains("active");
      occBtns.forEach((x) => {
        x.classList.remove("active");
        x.setAttribute("aria-pressed", "false");
      });
      if (!wasActive) {
        b.classList.add("active");
        b.setAttribute("aria-pressed", "true");
        if (occInput) occInput.value = b.dataset.occasion ?? "";
      } else if (occInput) {
        occInput.value = "";
      }
    }));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
      const status = form.querySelector<HTMLElement>("[data-status]");
      const fallback = form.querySelector<HTMLElement>("[data-fallback]");
      const endpoint = form.getAttribute("action") ?? "";
      if (!submit || !status) return;

      fallback?.setAttribute("hidden", "");
      submit.disabled = true;
      status.textContent = "Wird gesendet …";

      const showFallback = () => {
        const mail = form.querySelector<HTMLAnchorElement>("[data-mailto]");
        if (mail) mail.href = mailtoHref(form);
        fallback?.removeAttribute("hidden");
        status.textContent = "";
        submit.disabled = false;
      };

      const payload = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ ...payload, source: "fryhigh.de/tisch", ts: new Date().toISOString() }),
        });
        // 503 "mail not configured" und 502 "mail send failed": Worker kann nicht liefern, Mail-Fallback zeigen.
        if (res.status >= 500) { showFallback(); return; }
        if (!res.ok) throw new Error("HTTP " + res.status);
        status.textContent = "Anfrage ist raus. Die Crew bestätigt per Mail.";
        submit.classList.add("is-done");
      } catch (err) {
        console.error("table submit failed", err);
        if (err instanceof TypeError) { showFallback(); return; }
        status.textContent = "Hm, das hat nicht geklappt. Schreib uns kurz an info@fryhigh.de";
        submit.disabled = false;
      }
    });
  });

  // Vorbelegung des Anlasses (Kinder-CTA schickt "tisch:preset" mit {anlass: "Geburtstag"}).
  document.addEventListener("tisch:preset", (e) => {
    const anlass = (e as CustomEvent<{ anlass?: string }>).detail?.anlass;
    if (anlass) forms.forEach((f) => selectOccasion(f, anlass));
  });
</script>

<style>
  .tisch {
    --mono-min: 0.72rem; /* 11,5 px, CI-Untergrenze */
    --muted: color-mix(in oklab, var(--ink) 75%, transparent); /* ≥ 4,5:1 auf Cream */
    padding: clamp(64px, 9vw, 110px) clamp(20px, 6vw, 80px);
    background: var(--cream-warm);
    color: var(--ink);
  }

  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    max-width: var(--container-wide);
    margin: 0 auto;
  }

  .copy .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--navy);
    opacity: 1;
    margin-bottom: 12px;
    display: inline-block;
  }

  .copy h2 {
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 5vw, 3.75rem);
    text-transform: uppercase;
    line-height: 1;
    margin: 0 0 18px;
    color: var(--navy);
    letter-spacing: -0.5px;
  }
  .copy h2 .acc { color: var(--orange); }

  .intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 0 14px;
    color: var(--ink);
    max-width: 56ch;
  }

  .feat {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 18px;
    font-family: var(--font-body);
    font-size: 0.94rem;
  }
  .feat li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    color: var(--ink);
  }
  .feat .ico {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 4px;
    color: var(--orange);
  }

  /* ── Formular: Cream mit 1-px-Navy-Rahmen auf Cream-warm ── */
  .form-col {
    position: sticky;
    top: 88px;
  }

  .fp {
    background: var(--cream);
    color: var(--ink);
    border: 1px solid var(--navy);
    position: relative;
    box-shadow:
      0 18px 40px -18px rgba(26, 42, 78, 0.35),
      0 4px 12px -4px rgba(26, 42, 78, 0.15);
  }

  .fp-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    border-bottom: 1px dashed color-mix(in oklab, var(--ink) 35%, transparent);
    background: var(--cream);
  }
  .fp-stamp {
    width: 44px;
    height: 44px;
    background: var(--navy);
    color: var(--cream);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 17px;
    letter-spacing: 1px;
    border: 2px dashed var(--cream);
    box-shadow: 0 0 0 2px var(--navy);
    transform: rotate(-8deg);
    flex-shrink: 0;
  }
  .fp-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.05;
  }
  .fp-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--muted);
    margin-top: 2px;
  }

  .fp-honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .fp-section {
    padding: 18px 22px;
    border-bottom: 1px dashed color-mix(in oklab, var(--ink) 18%, transparent);
  }
  .fp-section--submit { border-bottom: 0; }

  .fp-section-title {
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .fp-section-title .hint {
    font-weight: 400;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .fp-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .fp-row + .fp-row { margin-top: 14px; }
  .fp-row--single { grid-template-columns: 1fr; }

  .fp-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .fp-field-label {
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fp-field input[type="text"],
  .fp-field input[type="email"],
  .fp-field input[type="tel"],
  .fp-field input[type="date"],
  .fp-field input[type="time"] {
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--ink);
    padding: 8px 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    width: 100%;
    min-height: 40px;
    border-radius: 0;
    outline: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .fp-field input::placeholder {
    color: color-mix(in oklab, var(--ink) 45%, transparent);
    font-style: italic;
  }
  .fp-field input:focus-visible,
  .fp-text:focus-visible,
  .fp-range:focus-visible,
  .fp-occ:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }
  .fp-field input:focus { border-bottom-color: var(--orange); }

  .fp-range-wrap { padding-top: 6px; }
  .fp-range-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .fp-range-row .n {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--ink);
    line-height: 1;
  }
  .fp-range-row .n small {
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-left: 6px;
  }

  .fp-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    background: linear-gradient(
      to right,
      var(--orange) 0%,
      var(--orange) var(--pax-pct, 9%),
      color-mix(in oklab, var(--ink) 18%, transparent) var(--pax-pct, 9%),
      color-mix(in oklab, var(--ink) 18%, transparent) 100%
    );
    cursor: pointer;
    border-radius: 0;
    margin-top: 6px;
  }
  .fp-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--orange);
    border: 3px solid var(--cream);
    box-shadow: 0 0 0 1.5px var(--orange), 0 4px 10px rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }
  .fp-range::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--orange);
    border: 3px solid var(--cream);
    box-shadow: 0 0 0 1.5px var(--orange), 0 4px 10px rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }
  .fp-range-readout {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--navy);
    margin-top: 8px;
  }

  /* Anlass-Pills, mindestens 40 px hoch */
  .fp-occasions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .fp-occ {
    background: transparent;
    border: 1.5px solid color-mix(in oklab, var(--ink) 40%, transparent);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-height: 40px;
    padding: 8px 14px;
    cursor: pointer;
    border-radius: 999px;
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }
  .fp-occ:hover { border-color: var(--ink); }
  .fp-occ.active {
    background: var(--navy);
    color: var(--cream);
    border-color: var(--navy);
  }

  .fp-text {
    width: 100%;
    background: transparent;
    border: 1.5px dashed color-mix(in oklab, var(--ink) 40%, transparent);
    padding: 14px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink);
    min-height: 80px;
    resize: vertical;
    border-radius: 0;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .fp-text::placeholder {
    color: color-mix(in oklab, var(--ink) 45%, transparent);
    font-style: italic;
  }
  .fp-text:focus { border-color: var(--orange); }

  /* Submit: globale .fh-btn, hier nur Breite und Icon-Abstand */
  .fp-submit {
    width: 100%;
    justify-content: center;
    gap: 10px;
  }
  .fp-submit .ico {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .fp-submit:hover:not(:disabled) .ico { transform: translateX(4px); }
  .fp-submit:disabled { cursor: default; opacity: 0.85; }
  .fp-submit.is-done { background: var(--green); opacity: 1; }

  .fp-meta {
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
    margin: 10px 0 0;
  }
  .fp-status {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--navy);
    text-align: center;
    margin: 8px 0 0;
    min-height: 1.4em;
  }
  .fp-status:empty { margin: 0; min-height: 0; }

