---
import { getEntry } from "astro:content";
import FloatingMascot from "./FloatingMascot.astro";

interface KidsItem { name: string; desc: string; price?: string; }
interface Props {
  eyebrow: string;
  headline: string;
  headline_accent?: string;
  intro: string;
  kids?: KidsItem[];
  // F21 (Joschka, 2026-09-11): Gruppenrabatt und Kuchen-Pauschale nennen.
  group_note?: string;
}

const {
  eyebrow,
  headline,
  headline_accent,
  intro,
  kids: kidsProp,
  group_note = "Ab 20 Personen gibt es 10 % auf alles. Mitgebrachter Kuchen: 15 € Servicepauschale.",
} = Astro.props;

// Kids-Karte aus karte.md (Namen, Beschreibung, Preis sobald eingetragen). Prop übersteuert.
const karte = kidsProp ? undefined : await getEntry("karte", "karte");
const kids: KidsItem[] = kidsProp ?? karte?.data.kids.items ?? [];
---
<section id="kinder" class="kinder has-mascot">
  <FloatingMascot
    image="06_Pinguin_Fries_Champignon.png"
    size={120}
    rotate={-12}
    top="40px"
    right="2.5%"
  />

  <div class="bg-shapes" aria-hidden="true">
    <span class="shape shape-yellow"></span>
    <span class="shape shape-pink"></span>
  </div>

  <header class="lead">
    <div class="lead-copy">
      <!-- Junior-Crew-Lockup (public/lockups/junior-crew.svg) inline, damit Anton und JetBrains Mono greifen. -->
      <svg class="sub-lockup" viewBox="0 0 800 240" role="img" aria-label="Junior Crew · Fry High">
        <g transform="translate(400,42)">
          <rect x="-90" y="-16" width="180" height="32" class="lk-tag-bg" />
          <text x="0" y="6" class="lk-mono lk-tag-text" font-size="13" text-anchor="middle" letter-spacing="6">FRY HIGH ·</text>
        </g>
        <text x="400" y="138" class="lk-display" font-size="92" text-anchor="middle" letter-spacing="2">JUNIOR CREW</text>
        <g class="lk-rule" stroke-width="2">
          <line x1="180" y1="170" x2="385" y2="170" />
          <line x1="415" y1="170" x2="620" y2="170" />
        </g>
        <circle cx="400" cy="170" r="5" class="lk-dot" />
        <text x="400" y="204" class="lk-mono" font-size="15" text-anchor="middle" letter-spacing="8">KINDERGEBURTSTAG · AB 4 JAHRE</text>
      </svg>
      <span class="eyebrow">{eyebrow}</span>
      <h2>
        {headline}
        {headline_accent && (<><br /><span class="acc">{headline_accent}</span></>)}
      </h2>
    </div>
    <p class="intro">{intro}</p>
  </header>

  <ol class="steps" role="list" aria-label="Geburtstag im Zoo am Meer in drei Schritten">
    <li class="step">
      <span class="step-num" aria-hidden="true">01</span>
      <h3>Tisch anfragen</h3>
      <p>Anlass Geburtstag, Anzahl der Kinder dazu.</p>
    </li>
    <li class="step step--kids">
      <span class="step-num" aria-hidden="true">02</span>
      <h3>Kids-Karte</h3>
      {kids.length > 0 ? (
        <ul class="kids" role="list">
          {kids.map((k) => (
            <li>
              <span class="k-name">{k.name}</span>
              <span class="k-desc">{k.desc}</span>
              {k.price && <span class="k-price">{k.price}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p>Kleiner Eisbär, Baby-Pinguin, Mini-Pilot.</p>
      )}
    </li>
    <li class="step step--note">
      <span class="step-num" aria-hidden="true">03</span>
      <span class="step-tag">Sag Bescheid</span>
      <h3>Allergien &amp; Wünsche</h3>
      <p>Vegan, glutenfrei, kein Schwein? Schreib es in die Anfrage, wir bauen die Karte um.</p>
    </li>
  </ol>

  <div class="foot">
    <div class="foot-notes">
      <p class="zoo-line">Zoo drumherum: Pinguine vor dem Essen, Eisbär danach. Oder andersrum.</p>
      {group_note && <p class="group-note">{group_note}</p>}
    </div>
    <a
      href="#tisch"
      class="fh-btn"
      data-kinder-cta
      aria-label="Geburtstags-Tisch anfragen, springt zur Tischanfrage"
    >
      <span>Geburtstags-Tisch anfragen</span>
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </div>
</section>

<script>
  // CTA: zum Tisch-Formular (liegt unter Kinder) scrollen und Anlass "Geburtstag" vorwählen.
  document.querySelectorAll<HTMLAnchorElement>("[data-kinder-cta]").forEach((cta) => {
    cta.addEventListener("click", (e) => {
      const target = document.getElementById("tisch");
      if (!target) return; // ohne Ziel greift der normale Anker
      e.preventDefault();
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      document.dispatchEvent(new CustomEvent("tisch:preset", { detail: { anlass: "Geburtstag" } }));
      // Fallback für den Fall, dass das Tisch-Skript den Event nicht kennt.
      window.setTimeout(() => {
        const occ = document.querySelector<HTMLButtonElement>('[data-table-form] .fp-occ[data-occasion="Geburtstag"]');
        if (occ && !occ.classList.contains("active")) occ.click();
      }, 400);
    });
  });
</script>

<style>
  .kinder {
    --mono-min: 0.72rem;
    --muted: color-mix(in oklab, var(--ink) 75%, transparent);
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 7vw, 88px) clamp(20px, 6vw, 80px);
    background: var(--cream);
    color: var(--ink);
  }

  /* Zwei leise Farbnebel, Junior-Crew-Energie ohne Cartoon */
  .bg-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.5;
  }
  .shape-yellow {
    top: -140px; right: -100px;
    width: 360px; height: 360px;
    background: radial-gradient(circle, color-mix(in oklab, var(--yellow) 55%, transparent) 0%, transparent 70%);
  }
  .shape-pink {
    bottom: -120px; left: 10%;
    width: 280px; height: 280px;
    background: radial-gradient(circle, color-mix(in oklab, var(--pink) 30%, transparent) 0%, transparent 70%);
  }

  /* ── Kopf ── */
  .lead {
    position: relative;
    z-index: 1;
    /* global.css .lead setzt italic; Anton hat keinen Kursivschnitt (CI §4.1). */
    font-style: normal;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: end;
    max-width: var(--container-wide);
    margin: 0 auto var(--space-6);
  }

  .sub-lockup {
    width: min(220px, 100%);
    height: auto;
    margin-bottom: 14px;
  }
  .lk-display { font-family: var(--font-display); fill: var(--navy); }
  .lk-mono { font-family: var(--font-mono); font-weight: 700; fill: var(--navy); }
  .lk-tag-bg { fill: var(--navy); }
  .lk-tag-text { fill: var(--cream); }
  .lk-rule { stroke: var(--navy); }
  .lk-dot { fill: var(--pink); }

  .kinder .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--navy);
    opacity: 1;
    display: inline-block;
    margin-bottom: 10px;
  }

  .kinder h2 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 0.96;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    color: var(--navy);
    margin: 0;
  }
  .kinder h2 .acc { color: var(--pink); }

  .intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-style: italic;
    color: var(--ink);
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  /* ── Drei Karten ── */
  .steps {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--container-wide);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .step {
    position: relative;
    padding: 22px 22px 22px 24px;
    background: color-mix(in oklab, var(--cream) 92%, var(--navy));
    border-left: 4px solid var(--orange);
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .step:nth-child(2) { border-left-color: var(--pink); }
  .step:nth-child(3) { border-left-color: var(--navy); }

  .step-num {
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    letter-spacing: 0.18em;
    color: var(--muted);
  }
  .step-tag {
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
  }
  .step h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--navy);
    margin: 0;
    line-height: 1;
  }
  .step p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }

  .kids {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .kids li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .k-name {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--navy);
  }
  .k-desc { color: var(--ink); }
  .k-price {
    font-family: var(--font-mono);
    font-size: var(--mono-min);
    letter-spacing: 0.06em;
    color: var(--navy);
    margin-left: auto;
  }

  /* ── Fuß: Hinweise links, CTA rechts ── */
  .foot {
    position: relative;
    z-index: 1;
    max-width: var(--container-wide);
    margin: var(--space-6) auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .foot-notes { display: grid; gap: 6px; max-width: 60ch; }
  .zoo-line {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--ink);
    margin: 0;
  }
  .group-note {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  .foot .fh-btn { gap: 10px; }
  .foot .ico {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  .foot .fh-btn:hover .ico { transform: translateX(4px); }

  @media (max-width: 980px) {
    .lead { grid-template-columns: 1fr; align-items: start; gap: 18px; }
    .steps { grid-template-columns: 1fr; }
    .foot { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .foot .ico { transition: none; }
    .foot .fh-btn:hover .ico { transform: none; }
  }
</style>
