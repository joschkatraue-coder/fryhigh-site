---
import type { CollectionEntry } from "astro:content";
import FloatingMascot from "./FloatingMascot.astro";

interface Props {
  eyebrow: string;
  headline: string;
  headline_accent?: string;
  intro: string;
  pakete: CollectionEntry<"kinder-pakete">[];
}

const { eyebrow, headline, headline_accent, intro, pakete } = Astro.props;
const sorted = [...pakete].sort((a, b) => a.data.order - b.data.order);
---
<section id="kinder" class="kinder has-mascot">
  <FloatingMascot
    image="06_Pinguin_Fries_Champignon.png"
    size={130}
    rotate={-12}
    bottom="14%"
    left="3%"
  />
  <FloatingMascot
    image="08_Seehund_Fries_Garnelen.png"
    size={110}
    rotate={8}
    top="18%"
    right="4%"
  />

  <div class="bg-shapes" aria-hidden="true">
    <span class="shape shape-yellow"></span>
    <span class="shape shape-pink"></span>
    <span class="shape shape-orange"></span>
  </div>

  <header class="kinder-lead">
    <div class="kinder-lead-copy">
      <img
        src="/lockups/junior-crew.svg"
        alt="Junior Crew · Fry High"
        class="sub-lockup"
        width="200"
        height="80"
      />
      <span class="eyebrow">{eyebrow}</span>
      <h2>
        {headline}
        {headline_accent && (<><br /><span class="acc">{headline_accent}</span></>)}
      </h2>
    </div>
    <p class="lead-text">{intro}</p>
  </header>

  <aside class="zoo-combo" aria-label="Kombi-Tag: Kindergeburtstag plus Zoo am Meer">
    <header class="zc-head">
      <span class="zc-eyebrow">Kombi · Crew + Zoo am Meer</span>
      <h3>
        Pommes-Mittag.<br />
        <span class="zc-acc">Zoo-Nachmittag.</span><br />
        Eis-Runde zurück.
      </h3>
      <p class="zc-lead">
        Zoo am Meer ist <strong>5 Minuten zu Fuß</strong> weg. Wir blocken eure Crew und Karte für die ganze Geburtstags-Schicht — kommt zurück wann ihr wollt. Eintritt Zoo nicht inklusive, aber Family-Ticket-Tipp gibt's per Mail dazu.
      </p>
      <svg class="zc-scribble" viewBox="0 0 120 36" aria-hidden="true">
        <path d="M4 18 C 28 -2, 60 38, 92 16 L 86 12 M 92 16 L 87 22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </header>

    <ol class="zc-flow" role="list">
      <li class="zc-step">
        <span class="zc-num">01</span>
        <svg class="zc-icon" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M9 12h14l-1.6 16H10.6L9 12ZM9 12v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2M12 16v6M16 14v8M20 16v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <h4>Boarding · 11 h</h4>
        <p>Crew anheuern. Kappe auf. Karte besprechen.</p>
      </li>
      <li class="zc-step">
        <span class="zc-num">02</span>
        <svg class="zc-icon" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M6 14h20l-2 14H8L6 14Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M10 8v8M14 6v10M18 8v8M22 7v9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <h4>Loaded Fries</h4>
        <p>Kindgerechte Karte. Pommes-Mal-Aktion.</p>
      </li>
      <li class="zc-step">
        <span class="zc-num">03</span>
        <svg class="zc-icon" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 4c-3.4 0-5.5 2.2-5.5 5.5v8c0 2 1 3.5 2.6 4.6L11 28h10l-2.1-5.9c1.6-1.1 2.6-2.6 2.6-4.6v-8C21.5 6.2 19.4 4 16 4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <circle cx="13.5" cy="11" r="0.9" fill="currentColor"/>
          <circle cx="18.5" cy="11" r="0.9" fill="currentColor"/>
        </svg>
        <h4>Zoo-Pause</h4>
        <p>5 Min Fußweg · Pinguine, Eisbär, Seehunde.</p>
      </li>
      <li class="zc-step">
        <span class="zc-num">04</span>
        <svg class="zc-icon" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M10 14h12L16 28 10 14Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M9 14c0-3.9 3.1-7 7-7s7 3.1 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M11 10c0.6-0.6 1.5-1 2.5-1M14 6c0.6-0.6 1.5-1 2.5-1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <h4>Eis-Runde</h4>
        <p>Zurück zur Crew. Foto-Bereich. Stempel.</p>
      </li>
    </ol>
  </aside>

  <ol class="kinder-grid" role="list">
    {sorted.map((p, i) => {
      const d = p.data;
      const num = String(i + 1).padStart(2, "0");
      const cargoSeed = `Kindergeburtstag · ${d.crew_name}\n· ${d.crew_size}, ${d.age_range ?? ""}, ${d.duration ?? ""}\n· Datum / Uhrzeit:\n· Allergien / Spezial-Wünsche:\n· Combo mit Zoo-Besuch? (ja / nein):`;
      return (
        <li class:list={["crew-card", { featured: d.featured }]}>
          {d.badge && <span class="crew-badge">{d.badge}</span>}

          <div class="crew-img">
            {d.image && (
              <img
                src={`/cutouts/${d.image}`}
                alt={d.crew_name}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>

          <div class="crew-body">
            <span class="crew-tag">Crew · {num}</span>
            <h3 class="crew-name">{d.crew_name}</h3>

            <ul class="kid-icons" role="list" aria-label="Was die Kinder erleben">
              <li title="Loaded Fries kindgerecht">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <path d="M6 14h20l-2 14H8L6 14Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                  <path d="M10 8v8M14 6v10M18 8v8M22 7v9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
              </li>
              <li title="Kapitänsmütze">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <path d="M5 22h22l-2-7a9 9 0 0 0-18 0l-2 7Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                  <path d="M5 22h22M14 14h4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
              </li>
              <li title="Pommes-Mal-Aktion">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <path d="M5 27l8-8M13 19l5 5L29 13a3.5 3.5 0 0 0-5-5L13 19Z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>
                  <path d="M5 27l-1 2 2-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
              </li>
              <li title="Foto-Bereich · Pilot-Stempel">
                <svg viewBox="0 0 32 32" aria-hidden="true">
                  <rect x="4" y="10" width="24" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2.2"/>
                  <path d="M11 10l1.6-3h6.8l1.6 3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
                  <circle cx="16" cy="18" r="4" fill="none" stroke="currentColor" stroke-width="2.2"/>
                </svg>
              </li>
            </ul>

            <dl class="crew-meta">
              <div><dt>Crew</dt><dd>{d.crew_size}</dd></div>
              {d.age_range && <div><dt>Alter</dt><dd>{d.age_range}</dd></div>}
              {d.duration && <div><dt>Dauer</dt><dd>{d.duration}</dd></div>}
              {d.location && <div><dt>Ort</dt><dd>{d.location}</dd></div>}
            </dl>

            <ul class="crew-includes">
              {d.includes.map((line) => <li>{line}</li>)}
            </ul>

            <div class="crew-price">
              <span class="price-from">ab</span>
              <span class="price-num">{d.price_from_eur}&nbsp;€</span>
              <span class="price-label">{d.price_label}</span>
            </div>
          </div>

          <button
            type="button"
            class="crew-cta"
            data-crew-cta
            data-crew={d.crew_name}
            data-cargo={cargoSeed}
            aria-label={`${d.cta_label ?? d.crew_name + ' anheuern'} — springt zur Catering-Anfrage`}
          >
            <span>{d.cta_label ?? `${d.crew_name} anheuern`}</span>
            <span class="arr" aria-hidden="true">→</span>
          </button>
        </li>
      );
    })}
  </ol>

  <ul class="kinder-extras" role="list">
    <li>
      <span class="ex-tag">Inklusive</span>
      <h4>Foto-Bereich</h4>
      <p>Pilot-Stempel, Kapitänsmütze, Holz-Steuerrad. Eltern dürfen knipsen — kein Pflicht-Hashtag, kein Insta-Stress.</p>
    </li>
    <li>
      <span class="ex-tag">Optional</span>
      <h4>Allergien & Spezial-Wünsche</h4>
      <p>Vegan, glutenfrei, no Schwein, no Mais — schreib's in die Cargo-Manifest-Zeile. Wir bauen die Karte um.</p>
    </li>
    <li>
      <span class="ex-tag">Wichtig</span>
      <h4>Vorlauf 14 Tage</h4>
      <p>Crew + Karte werden für euch geblockt. Slots Samstag mittag gehen früh raus — lieber gleich anfragen.</p>
    </li>
  </ul>
</section>

<script>
  // Hand-Off: Crew-CTA → Catering-Form mit Gate=Privat + Cargo-Seed.
  // Caveman: läuft einmal beim DOM-Ready, kein Cleanup nötig.
  document.querySelectorAll<HTMLButtonElement>('[data-crew-cta]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const crew = btn.dataset.crew ?? '';
      const cargo = btn.dataset.cargo ?? '';

      // Stamp-Animation auf Button (visuelles Feedback)
      btn.classList.add('stamping');
      window.setTimeout(() => btn.classList.remove('stamping'), 480);

      const form = document.querySelector<HTMLFormElement>('[data-catering-form]');
      const target = document.getElementById('catering');

      if (form) {
        // Privat-Gate clicken (Form-Logik in Catering.astro setzt active + hidden input)
        const privatGate = form.querySelector<HTMLButtonElement>('[data-gate-value="Privat"]');
        if (privatGate) privatGate.click();

        const cargoTa = form.querySelector<HTMLTextAreaElement>('textarea[name="cargo"]');
        if (cargoTa) {
          cargoTa.value = cargo;
        }

        // Optional: Pax-Slider auf Minimum (50, Kindergeburtstag selten >50)
        const pax = form.querySelector<HTMLInputElement>('[data-pax-range]');
        if (pax) {
          pax.value = String(pax.min || 50);
          pax.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }

      // Smooth scroll zur Catering-Sektion
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // Nach dem Scroll: Cargo-Feld fokussieren (wartet auf Scroll-Ende, fallback 700ms)
      window.setTimeout(() => {
        const cargoTa = document.querySelector<HTMLTextAreaElement>('[data-catering-form] textarea[name="cargo"]');
        cargoTa?.focus();
      }, 700);

      // Telemetry-Hook (optional, no-op falls nicht gesetzt)
      if (typeof window !== 'undefined' && (window as any).fryhighTrack) {
        (window as any).fryhighTrack('kinder_handoff', { crew });
      }
    });
  });
</script>

<style>
  .kinder {
    position: relative;
    overflow: hidden;
    padding: clamp(60px, 9vw, 110px) clamp(20px, 6vw, 80px);
    background: linear-gradient(180deg, var(--cream-warm) 0%, var(--cream) 60%, var(--cream-warm) 100%);
    color: var(--ink);
  }

  /* Playful background shapes — Junior Crew energy ohne Cartoon-Slop */
  .bg-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.55;
  }
  .shape-yellow {
    top: -120px; right: -80px;
    width: 360px; height: 360px;
    background: radial-gradient(circle, color-mix(in oklab, var(--yellow) 60%, transparent) 0%, transparent 70%);
  }
  .shape-pink {
    bottom: -100px; left: 12%;
    width: 280px; height: 280px;
    background: radial-gradient(circle, color-mix(in oklab, var(--pink) 35%, transparent) 0%, transparent 70%);
  }
  .shape-orange {
    top: 38%; left: -120px;
    width: 240px; height: 240px;
    background: radial-gradient(circle, color-mix(in oklab, var(--orange) 30%, transparent) 0%, transparent 70%);
  }

  /* Lead row */
  .kinder-lead {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
    max-width: var(--container-wide);
    margin: 0 auto var(--space-8);
  }

  .sub-lockup {
    display: block;
    height: 64px;
    width: auto;
    margin-bottom: var(--space-4);
    /* Sub-Lockup ist navy/pink — kein Filter nötig auf cream */
  }

  .kinder .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--orange);
    display: inline-block;
    margin-bottom: 12px;
  }

  .kinder h2 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    color: var(--navy);
    margin: 0;
  }

  .kinder h2 .acc { color: var(--pink); }

  .lead-text {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-style: italic;
    color: color-mix(in oklab, var(--ink) 75%, transparent);
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  /* Card grid */
  .kinder-grid {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--container-wide);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .crew-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 2px solid var(--navy);
    box-shadow: 0 6px 0 0 var(--navy), 0 18px 30px -12px rgba(20, 30, 50, 0.18);
    transition:
      transform 280ms var(--ease-out),
      box-shadow 280ms var(--ease-out);
  }

  .crew-card:hover {
    transform: translateY(-6px) rotate(-0.4deg);
    box-shadow: 0 10px 0 0 var(--navy), 0 28px 44px -10px rgba(20, 30, 50, 0.28);
  }

  .crew-card.featured {
    background: var(--navy);
    color: var(--cream);
    transform: translateY(-8px);
    box-shadow: 0 8px 0 0 var(--pink), 0 24px 44px -12px rgba(20, 30, 50, 0.4);
  }

  .crew-card.featured:hover {
    transform: translateY(-14px) rotate(-0.4deg);
  }

  .crew-badge {
    position: absolute;
    top: -14px;
    right: 18px;
    background: var(--orange);
    color: var(--cream);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 6px 12px;
    border: 2px solid var(--cream);
    transform: rotate(3deg);
    z-index: 2;
    box-shadow: 0 2px 0 0 var(--navy);
  }

  .crew-img {
    aspect-ratio: 5 / 4;
    background:
      radial-gradient(circle at 50% 110%, color-mix(in oklab, var(--yellow) 30%, transparent) 0%, transparent 60%),
      linear-gradient(180deg, var(--cream-warm) 0%, var(--cream) 100%);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 2px solid var(--navy);
    position: relative;
  }

  .crew-card.featured .crew-img {
    background:
      radial-gradient(circle at 50% 110%, color-mix(in oklab, var(--pink) 45%, transparent) 0%, transparent 60%),
      linear-gradient(180deg, color-mix(in oklab, var(--navy) 92%, var(--navy-deep)) 0%, var(--navy) 100%);
    border-bottom-color: var(--pink);
  }

  .crew-img img {
    width: 78%;
    height: 78%;
    object-fit: contain;
    filter:
      drop-shadow(2px 2px 0 white)
      drop-shadow(-2px -2px 0 white)
      drop-shadow(2px -2px 0 white)
      drop-shadow(-2px 2px 0 white)
      drop-shadow(0 14px 20px rgba(0, 0, 0, 0.3));
    transition: transform 360ms var(--ease-out);
  }

  .crew-card:hover .crew-img img {
    transform: scale(1.06) rotate(-3deg);
  }

  .crew-body {
    padding: 22px 22px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .crew-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, currentColor 55%, transparent);
  }

  .crew-card.featured .crew-tag { color: var(--pink); opacity: 1; }

  .crew-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1;
    margin: 0;
    color: var(--navy);
  }

  .crew-card.featured .crew-name { color: var(--cream); }

  .crew-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 14px;
    padding: 12px 0;
    border-top: 1px dashed color-mix(in oklab, currentColor 35%, transparent);
    border-bottom: 1px dashed color-mix(in oklab, currentColor 35%, transparent);
    margin: 0;
  }
  .crew-meta > div { display: flex; flex-direction: column; gap: 2px; }
  .crew-meta dt {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklab, currentColor 55%, transparent);
    margin: 0;
  }
  .crew-meta dd {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: currentColor;
    margin: 0;
    letter-spacing: 0.3px;
  }

  .crew-includes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.94rem;
    line-height: 1.4;
  }
  .crew-includes li {
    padding-left: 20px;
    position: relative;
    color: color-mix(in oklab, currentColor 85%, transparent);
  }
  .crew-includes li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--orange);
    font-weight: 700;
  }
  .crew-card.featured .crew-includes li::before { color: var(--pink); }

  .crew-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-top: 12px;
    margin-top: auto;
    border-top: 1px solid color-mix(in oklab, currentColor 20%, transparent);
  }
  .price-from {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in oklab, currentColor 55%, transparent);
  }
  .price-num {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--orange);
    letter-spacing: -0.5px;
  }
  .crew-card.featured .price-num { color: var(--pink); }
  .price-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in oklab, currentColor 55%, transparent);
  }

  /* CTA */
  .crew-cta {
    background: var(--orange);
    color: var(--cream);
    border: none;
    border-top: 2px solid var(--navy);
    padding: 18px 22px;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
    border-radius: 0;
  }
  .crew-card.featured .crew-cta {
    background: var(--pink);
    color: var(--cream);
    border-top-color: var(--pink);
  }
  .crew-cta:hover { background: color-mix(in oklab, var(--orange) 85%, black); }
  .crew-card.featured .crew-cta:hover { background: color-mix(in oklab, var(--pink) 85%, black); }
  .crew-cta .arr {
    display: inline-block;
    transition: transform 200ms var(--ease-out);
    font-size: 1.25rem;
  }
  .crew-cta:hover .arr { transform: translateX(6px); }

  /* Click-stamp Animation — kurzes "Boarding-Stempel"-Feedback */
  .crew-cta.stamping {
    animation: stamp 480ms var(--ease-out);
  }
  @keyframes stamp {
    0%   { transform: scale(1); }
    20%  { transform: scale(0.96); }
    40%  { transform: scale(1.02); box-shadow: inset 0 0 0 3px var(--cream); }
    100% { transform: scale(1); box-shadow: inset 0 0 0 0 transparent; }
  }

  /* Extras row */
  .kinder-extras {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: var(--space-8) auto 0;
    padding: 0;
    max-width: var(--container-wide);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .kinder-extras > li {
    padding: 24px;
    background: color-mix(in oklab, var(--cream) 92%, var(--navy));
    border-left: 4px solid var(--orange);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
