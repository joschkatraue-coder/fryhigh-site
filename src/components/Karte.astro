---
/* Karte (#karte). Rendert src/content/karte.md.
   mode "anker":   drei große Preisanker, Stand-Stempel, Kids-Karte, Getränke, Vegan, Allergene,
                   Instagram-Hinweis.
   mode "kompakt": zusätzlich die Tafel „Fünf, die bleiben.“ nach CI v1 §12.4 (Cream, Navy-Rahmen,
                   Mono-Eyebrow, Anton-Name, Crimson-Italic-Beschreibung, Mono-Preis), ohne Cutouts.
   Preise werden nur gerendert, wenn sie im Content stehen; fehlen sie überall, entfällt auch
   „Preise inkl. MwSt.“ im Stempel (F12/F13 können die Karte preislos machen).
   Foto: src/assets/photos/fries-topdown.jpg (analyse/08-fotos.md §3). Ein Mascot am Rand, mobil keins. */
import { Picture } from "astro:assets";
import FloatingMascot from "./FloatingMascot.astro";
import friesTopdown from "../assets/photos/fries-topdown.jpg";

interface Anker {
  label: string;
  price_from: string;
}

interface Item {
  name: string;
  desc: string;
  price: string;
  tags: string[];
}

interface KidsItem {
  name: string;
  desc: string;
  price?: string;
}

interface Props {
  eyebrow: string;
  headline: string;
  headline_accent?: string;
  stand: string;
  mode: "anker" | "kompakt";
  anker: Anker[];
  items: Item[];
  kids: { intro: string; items: KidsItem[] };
  drinks: string;
  vegan_note: string;
  allergen_note: string;
  instagram_note: string;
  instagram_url: string;
}

const {
  eyebrow,
  headline,
  headline_accent,
  stand,
  mode = "anker",
  anker,
  items,
  kids,
  drinks,
  vegan_note,
  allergen_note,
  instagram_note,
  instagram_url,
} = Astro.props;

const has = (s?: string) => Boolean(s && s.trim() !== "");
const kidsHavePrices = kids.items.some((k) => has(k.price));
const hasPrices =
  anker.some((a) => has(a.price_from)) ||
  (mode === "kompakt" && items.some((i) => has(i.price))) ||
  kidsHavePrices;

// F15: sobald public/allergene.pdf liegt, hier auf "/allergene.pdf" (Stand Juni 2026) umstellen.
const allergenHref = "/allergene.pdf";

const photoAlt =
  "Loaded Fries von oben mit zwei bunten Saucen, Frühlingszwiebeln, Sesam und Drachenfrucht, gehalten in schwarzen Handschuhen.";
---
<section class="karte has-mascot" id="karte" aria-label="Karte">
  <FloatingMascot
    image="04_Cheese_Fries.png"
    size={150}
    rotate={9}
    top="56px"
    right="3%"
  />

  <div class="inner">
    <div class="head">
      <span class="eyebrow">{eyebrow}</span>
      <h2>
        {headline}
        {headline_accent && (
          <>
            <br />
            <span class="accent">{headline_accent}</span>
          </>
        )}
      </h2>
      <span class="stand">Karte · Stand {stand}{kidsHavePrices && " · Kids-Preise inkl. MwSt."}</span>
    </div>

    <div class="board">
      <div class="main">
        {anker.length > 0 && (
          <ul class="anker" aria-label="Preisanker">
            {anker.map((a) => (
              <li class="anker-item">
                {has(a.price_from) && <span class="anker-price">{a.price_from}</span>}
                <span class="anker-label">{a.label}</span>
              </li>
            ))}
          </ul>
        )}

        {mode === "kompakt" && items.length > 0 && (
          <div class="tafel">
            <h3 class="tafel-title">Zoo-Edition. Hängt gerade.</h3>
            <ul class="tafel-list">
              {items.map((item) => (
                <li class="dish">
                  <div class="dish-head">
                    <span class="dish-name">{item.name}</span>
                    {has(item.price) && <span class="dish-price">{item.price}</span>}
                  </div>
                  <p class="dish-desc">{item.desc}</p>
                  {item.tags.length > 0 && (
                    <ul class="tags">
                      {item.tags.map((t) => <li>{t}</li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="blocks">
          <div class="block block-kids">
            <h3>Kids-Karte</h3>
            <p class="block-intro">{kids.intro}</p>
            <ul class="kids-list">
              {kids.items.map((k) => (
                <li class="kid">
                  <span class="kid-name">{k.name}</span>
                  <span class="kid-desc">{k.desc}</span>
                  {has(k.price) && <span class="kid-price">{k.price}</span>}
                </li>
              ))}
            </ul>
            {!kidsHavePrices && <span class="mono-note">Preise am Tresen.</span>}
          </div>

          <div class="block">
            <h3>Getränke</h3>
            <p>{drinks}</p>
          </div>

          <div class="block">
            <h3>Vegan</h3>
            <p>{vegan_note}</p>
          </div>
        </div>

        <div class="notes">
          <p class="mono-note">
            {allergen_note}
            <a class="fh-link" href={allergenHref} target="_blank" rel="noopener">Allergenliste (PDF, Stand Juni 2026)</a>
          </p>
          <p class="mono-note">
            {instagram_note}
            <a class="fh-link" href={instagram_url} target="_blank" rel="noopener">Specials auf Instagram →</a>
          </p>
        </div>
      </div>

      <figure class="photo">
        <Picture
          src={friesTopdown}
          alt={photoAlt}
          widths={[480, 800, 1080]}
          sizes="(max-width: 860px) 100vw, 34vw"
          formats={["avif", "webp"]}
          quality={80}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .karte {
    background: var(--cream-warm);
    color: var(--ink);
    padding: var(--space-7) clamp(20px, 5vw, 64px);
  }

  .inner {
    max-width: var(--container-grid);
    margin: 0 auto;
    display: grid;
    gap: var(--space-6);
  }

  .head {
    display: grid;
    gap: var(--space-3);
    max-width: 820px;
    justify-items: start;
  }

  .head h2 {
    color: var(--navy);
  }

  .head .accent {
    color: var(--orange);
  }

  .stand {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 7px 12px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-min);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
    border: 1.5px solid var(--navy);
    transform: rotate(-2deg);
    transform-origin: left center;
  }

  .board {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-6);
    align-items: start;
  }

  .main {
    display: grid;
    gap: var(--space-6);
  }

  /* Preisanker */
  .anker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid color-mix(in oklab, var(--navy) 18%, transparent);
  }

  .anker-item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .anker-price {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--navy);
    white-space: nowrap;
  }

  .anker-label {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* Tafel (mode kompakt), CI v1 §12.4 */
  .tafel {
    background: var(--cream);
    border: 3px solid var(--navy);
    outline: 1px solid var(--cream-hairline);
    outline-offset: -9px;
    padding: clamp(20px, 3vw, 36px);
    display: grid;
    gap: var(--space-4);
  }

  .tafel-title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    color: var(--navy);
  }

  .tafel-list {
    display: grid;
    gap: var(--space-4);
  }

  .dish {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--cream-hairline);
  }

  .dish-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }

  .dish-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .dish-price {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--navy);
    white-space: nowrap;
  }

  .dish-desc {
    font-family: var(--font-body);
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: var(--t-mono-min);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 9px;
    border: 1px solid color-mix(in oklab, var(--navy) 30%, transparent);
    color: var(--navy);
  }

  /* Kids · Getränke · Vegan */
  .blocks {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
  }

  .block {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .block h3 {
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    color: var(--navy);
  }

  .block p {
    line-height: 1.55;
  }

  .block-intro {
    font-style: italic;
    color: var(--ink-soft);
  }

  .kids-list {
    display: grid;
    gap: var(--space-2);
  }

  .kid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-3);
    align-items: baseline;
  }

  .kid-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .kid-desc {
    grid-column: 1;
    font-family: var(--font-body);
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .kid-price {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--navy);
    white-space: nowrap;
  }

  .mono-note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .notes {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in oklab, var(--navy) 18%, transparent);
  }

  .notes .fh-link {
    margin-left: 0.4em;
  }

  /* Foto */
  .photo {
    position: sticky;
    top: 96px;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--navy);
    box-shadow: 0 24px 48px -28px color-mix(in oklab, var(--navy) 55%, transparent);
  }

  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  /* Mascot erst ab 1024 px: darunter reicht der Platz neben der Überschrift nicht. */
  @media (max-width: 1023px) {
    .karte > :global(.mascot) {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .board {
      grid-template-columns: 1fr;
    }

    .photo {
      position: static;
      aspect-ratio: 4 / 3;
      order: -1;
    }

    .blocks {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .karte {
      padding: var(--space-6) 20px;
    }

    .inner,
    .main {
      gap: var(--space-5);
    }

    .anker {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .anker-price {
      font-size: 1.75rem;
    }

    .anker-label {
      font-size: var(--t-mono-min);
    }
  }

  @media (max-width: 420px) {
    .anker {
      grid-template-columns: 1fr;
    }
  }
</style>
