---
// Pommespilot · Mini-Spiel „Sammelflug“.
// Engine (Physik, Spawn, Punkte, Sets): src/scripts/pommespilot.js (reines JS, kein DOM).
// Hier: Canvas-Rendering als Vektorpfade in CI-Farben, DPR-Skalierung, HUD, Overlays,
// Sound (WebAudio, Standard aus), Session/Submit gegen den Worker, Rang, Mail-Status.
// Formular liegt UNTER dem Canvas (mobil nicht im Spielrahmen). Alle API-Calls gehen an `apiBase`.

interface Props {
  apiBase?: string;
  contestLive?: boolean;
  prizeLabel?: string;
  minAge?: number;
  termsVersion?: string;
}

const {
  apiBase = "https://fryhigh-game.fryhigh-bhv.workers.dev",
  contestLive = false,
  prizeLabel = "Wer am Sonntag oben steht, bekommt einen 15-€-Gutschein für Fry High.",
  minAge = 18,
  termsVersion = "2026-09-16",
} = Astro.props;
---
<div
  class="pp"
  data-pommespilot
  data-api-base={apiBase}
  data-contest-live={contestLive ? "1" : "0"}
  data-terms-version={termsVersion}
>
  <div class="pp-account">
    <p data-player-state>{contestLive ? "Als Gast fliegen oder mit eigenem Namen in die Bestenliste." : "Gastspiel ist offen. Die Anmeldung zur Wochenwertung folgt."}</p>
    <button type="button" class="pp-account-button" data-login-toggle disabled={!contestLive}>{contestLive ? "Anmelden" : "Anmeldung folgt"}</button>
    <button type="button" class="pp-account-button" data-logout hidden>Abmelden</button>
  </div>
  <p class="pp-account-status" data-run-status role="status" aria-live="polite"></p>
  <button type="button" class="pp-account-button pp-retry" data-retry-score hidden>Nochmal versuchen</button>

  <div class="pp-stage" data-stage>
    <canvas
      class="pp-canvas"
      data-canvas
      width="960"
      height="540"
      role="application"
      tabindex="0"
      aria-label="Pommespilot. Jeder Klick, Tipp oder Druck auf die Leertaste gibt dem Flieger einen Aufwärtsimpuls. Danach sinkt er wieder. Drücke oder tippe für den nächsten Impuls erneut. Zutaten sammeln, Möwen und Ketchup ausweichen."
    ></canvas>

    <div class="pp-hud" aria-hidden="true">
      <div class="hud-cell">
        <span class="hud-label">Punkte</span>
        <span class="hud-value" data-score>0</span>
      </div>
      <div class="hud-cell">
        <span class="hud-label">Bestwert</span>
        <span class="hud-value" data-best>0</span>
      </div>
      <div class="hud-cell hud-set">
        <span class="hud-label hud-set-name" data-set-name>Kreation</span>
        <span class="hud-dots" data-set-dots><i></i><i></i><i></i></span>
      </div>
    </div>

    <button type="button" class="pp-sound" data-sound aria-pressed="false" aria-label="Sound einschalten">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path class="snd-body" d="M4 9v6h4l5 4V5L8 9H4z" />
        <path class="snd-wave" d="M16 8.5a4.5 4.5 0 0 1 0 7" />
        <path class="snd-off" d="M16 9l5 6M21 9l-5 6" />
      </svg>
    </button>

    <span class="sr-only" data-announce aria-live="polite" aria-atomic="true"></span>

    <div class="pp-overlay" data-overlay="idle">
      <div class="pp-card">
        <div class="pp-eyebrow">Pommespilot</div>
        <h2>Flieg. Sammel. Schmier nicht ab.</h2>
        <p>
          Jeder Klick, Tipp<span class="kbd-hint"> oder Druck auf die <kbd>Leertaste</kbd></span> gibt dem Flieger einen Aufwärtsimpuls. Danach sinkt er wieder. Drücke oder tippe für den nächsten Impuls erneut. Zutaten geben Punkte, drei von einer Kreation
          geben Bonus. Möwen, Ketchup, Wolkendecke und Wasser sind Schluss.
        </p>
        <button type="button" class="fh-btn" data-start>Ballern wir los</button>
        {contestLive && <p class="pp-mini">{prizeLabel}</p>}
      </div>
    </div>

    <div class="pp-overlay" data-overlay="pause" hidden>
      <div class="pp-card pp-card--slim">
        <div class="pp-eyebrow">Pause</div>
        <h2>Kurz durchatmen.</h2>
        <p>Tipp, Klick<span class="kbd-hint"> oder <kbd>Leertaste</kbd></span>, dann geht es weiter.</p>
      </div>
    </div>

    <div class="pp-overlay" data-overlay="over" hidden>
      <div class="pp-card">
        <div class="pp-eyebrow">Abgeschmiert</div>
        <h2>Abgeschmiert bei <span data-final>0</span>.</h2>
        <p class="pp-note" data-best-note hidden>Neuer Bestwert.</p>
        <p class="pp-rank" data-rank hidden></p>
        <div class="pp-actions">
          <button type="button" class="fh-btn" data-restart>Nochmal fliegen</button>
          <button type="button" class="fh-btn fh-btn--ghost" data-to-form hidden={!contestLive}>Anmelden &amp; Score sichern</button>
          <a class="fh-link" href="#wochenwertung">Bestenliste ansehen</a>
        </div>
        {!contestLive && (
          <p class="pp-mini">Bestwert hier im Browser: <span data-over-best>0</span>.</p>
        )}
      </div>
    </div>
  </div>

  <form class="pp-form" id="spieler-anmeldung" data-score-form hidden>
    <div class="pp-form-head">
      <span class="pp-eyebrow">Dein Platz in der Bestenliste</span>
      <h2>Unter welchem Namen fliegst du?</h2>
      <p class="pp-form-lead">{contestLive ? "E-Mail einmal bestätigen. Danach zählen deine Flüge automatisch." : "Die Anmeldung ist noch nicht freigeschaltet. Sobald es losgeht, bestätigst du hier einmal deine E-Mail."}</p>
    </div>
    <label class="pp-field">
      <span class="pp-label">Dein Name in der Bestenliste · gern ein Pseudonym</span>
      <input type="text" name="display_name" required maxlength="32" autocomplete="nickname" placeholder="z. B. Möwenschreck" />
    </label>
    <label class="pp-field">
      <span class="pp-label">E-Mail · bleibt privat</span>
      <input type="email" name="email" required autocomplete="email" placeholder="du@beispiel.de" />
    </label>
    <input class="pp-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="pp-check">
      <input type="checkbox" name="terms" required />
      <span>Ich akzeptiere die <a href="/spiel/teilnahmebedingungen" target="_blank" rel="noopener">Spielregeln</a> und habe die <a href="/datenschutz" target="_blank" rel="noopener">Datenschutzhinweise</a> gelesen.</span>
    </label>
    <label class="pp-check">
      <input type="checkbox" name="age" required />
      <span>Ich bin mindestens {minAge} Jahre alt.</span>
    </label>
    <button type="submit" class="fh-btn" data-submit>Anmeldelink schicken</button>
    <button type="button" class="pp-account-button" data-login-cancel>Als Gast weiterspielen</button>
    <p class="pp-meta" data-form-meta role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  import {
    createState,
    step,
    startRun,
    drainEvents,
    activeProgress,
    INGREDIENTS,
    CREATIONS,
    COLORS,
    H,
    W_DEFAULT,
    W_MIN,
    CEIL_Y,
    WATER_Y,
    GLYPH,
    GULL_SIZE,
    BLOB_R,
  } from '../scripts/pommespilot.js';

  type Phase = 'idle' | 'playing' | 'crashing' | 'over';
  interface Gull { x: number; y: number; phase: number }
  interface BlobItem { x: number; y: number; wobble: number }
  interface Ing { x: number; y: number; kind: number; spin: number }
  interface GameState {
    w: number;
    phase: Phase;
    frames: number;
    score: number;
    speed: number;
    difficulty: number;
    player: { x: number; y: number; vy: number; angle: number };
    gulls: Gull[];
    blobs: BlobItem[];
    ingredients: Ing[];
    activeCreation: number;
    crashAt: { x: number; y: number } | null;
  }
  interface GameEvent { type: string; x?: number; y?: number; points?: number; kind?: number; name?: string; score?: number }
  interface Particle { x: number; y: number; vx: number; vy: number; life: number; max: number; size: number; color: string; g: number }
  interface Popup { x: number; y: number; text: string; life: number; max: number; color: string; size: number }
  interface Toast { text: string; life: number; max: number }

  const ROOT = document.querySelector<HTMLElement>('[data-pommespilot]');
  if (!ROOT) throw new Error('Pommespilot: Wurzel fehlt');
  const apiBase = ROOT.dataset.apiBase ?? '';
  const contestLive = ROOT.dataset.contestLive === '1';
  const termsVersion = ROOT.dataset.termsVersion ?? '2026-09-16';

  function q<T extends HTMLElement>(sel: string): T | null {
    return ROOT!.querySelector<T>(sel);
  }
  const stage = q<HTMLElement>('[data-stage]')!;
  const canvas = q<HTMLCanvasElement>('[data-canvas]')!;
  const ctx = canvas.getContext('2d')!;
  const scoreEl = q<HTMLElement>('[data-score]')!;
  const bestEl = q<HTMLElement>('[data-best]')!;
  const setNameEl = q<HTMLElement>('[data-set-name]')!;
  const setDots = Array.from(q<HTMLElement>('[data-set-dots]')!.children) as HTMLElement[];
  const soundBtn = q<HTMLButtonElement>('[data-sound]')!;
  const announce = q<HTMLElement>('[data-announce]')!;
  const overlays = {
    idle: q<HTMLElement>('[data-overlay="idle"]')!,
    pause: q<HTMLElement>('[data-overlay="pause"]')!,
    over: q<HTMLElement>('[data-overlay="over"]')!,
  };
  const finalEl = q<HTMLElement>('[data-final]')!;
  const bestNote = q<HTMLElement>('[data-best-note]')!;
  const rankEl = q<HTMLElement>('[data-rank]')!;
  const overBestEl = q<HTMLElement>('[data-over-best]');
  const soonBestEl = q<HTMLElement>('[data-soon-best]');
  const startBtn = q<HTMLButtonElement>('[data-start]')!;
  const restartBtn = q<HTMLButtonElement>('[data-restart]')!;
  const toFormBtn = q<HTMLButtonElement>('[data-to-form]');
  const form = q<HTMLFormElement>('[data-score-form]');
  const submitBtn = q<HTMLButtonElement>('[data-submit]');
  const formMeta = q<HTMLElement>('[data-form-meta]');
  const playerState = q<HTMLElement>('[data-player-state]')!;
  const runStatus = q<HTMLElement>('[data-run-status]')!;
  const loginToggle = q<HTMLButtonElement>('[data-login-toggle]')!;
  const logoutBtn = q<HTMLButtonElement>('[data-logout]')!;
  const retryScore = q<HTMLButtonElement>('[data-retry-score]')!;

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const FONT_MONO = "'JetBrains Mono', 'SFMono-Regular', Consolas, monospace";
  const FONT_DISPLAY = "'Anton', 'Impact', system-ui, sans-serif";
  const C = COLORS as Record<string, string>;
  const clamp = (v: number, lo: number, hi: number) => (v < lo ? lo : v > hi ? hi : v);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  // ── Persistenz (localStorage kann fehlen oder werfen) ──────────────────────
  function readStore(key: string): string | null {
    try { return localStorage.getItem(key); } catch { return null; }
  }
  function writeStore(key: string, value: string) {
    try { localStorage.setItem(key, value); } catch { /* privat, voll, gesperrt: egal */ }
  }

  let best = Math.max(0, Math.floor(Number(readStore('pp_best') ?? 0)) || 0);
  bestEl.textContent = String(best);
  if (soonBestEl) soonBestEl.textContent = String(best);

  // ── Sound (Oszillatoren, Standard aus) ─────────────────────────────────────
  let soundOn = readStore('pp_sound') === '1';
  let audio: AudioContext | null = null;
  function applySoundUi() {
    soundBtn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
    soundBtn.setAttribute('aria-label', soundOn ? 'Sound ausschalten' : 'Sound einschalten');
    soundBtn.classList.toggle('is-on', soundOn);
  }
  applySoundUi();
  function beep(freqFrom: number, freqTo: number, ms: number, type: OscillatorType, gain = 0.06, delay = 0) {
    if (!soundOn) return;
    try {
      audio ??= new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
      if (audio.state === 'suspended') void audio.resume();
      const t0 = audio.currentTime + delay;
      const osc = audio.createOscillator();
      const g = audio.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freqFrom, t0);
      osc.frequency.exponentialRampToValueAtTime(Math.max(20, freqTo), t0 + ms / 1000);
      g.gain.setValueAtTime(0.0001, t0);
      g.gain.exponentialRampToValueAtTime(gain, t0 + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + ms / 1000);
      osc.connect(g).connect(audio.destination);
      osc.start(t0);
      osc.stop(t0 + ms / 1000 + 0.02);
    } catch { /* kein Audio: still */ }
  }
  const sfx = {
    tap: () => beep(420, 640, 60, 'square', 0.03),
    pickup: () => beep(880, 1320, 90, 'sine', 0.06),
    gull: () => beep(660, 700, 40, 'triangle', 0.02),
    set: () => { beep(660, 660, 90, 'square', 0.05); beep(880, 880, 90, 'square', 0.05, 0.09); beep(1320, 1320, 160, 'square', 0.05, 0.18); },
    crash: () => { beep(220, 50, 320, 'sawtooth', 0.08); beep(160, 40, 400, 'square', 0.04, 0.05); },
  };
  soundBtn.addEventListener('click', () => {
    soundOn = !soundOn;
    writeStore('pp_sound', soundOn ? '1' : '0');
    applySoundUi();
    if (soundOn) sfx.tap();
  });

  // ── Canvas-Größe und DPR ───────────────────────────────────────────────────
  let scale = 1;
  let offsetX = 0;
  let logicalW = W_DEFAULT;
  function fitCanvas() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    const cssW = Math.max(1, rect.width);
    const cssH = Math.max(1, rect.height);
    canvas.width = Math.round(cssW * dpr);
    canvas.height = Math.round(cssH * dpr);
    scale = canvas.height / H;
    logicalW = Math.round(clamp((H * cssW) / cssH, W_MIN, W_DEFAULT));
    offsetX = Math.max(0, (canvas.width - logicalW * scale) / 2);
    // Nur im Leerlauf neu anlegen: nach dem Crash bleibt der Zustand (Score, Szene) stehen.
    if (state.phase === 'idle' && state.w !== logicalW) state = createState({ width: logicalW }) as GameState;
  }

  // ── Spielzustand und Effekte ───────────────────────────────────────────────
  let state = createState({ width: W_DEFAULT }) as GameState;
  let paused = false;
  let tapQueued = false;
  let lastTs = 0;
  let bg = 0;             // Parallax-Strecke
  let propAngle = 0;
  let shake = 0;          // Restzeit Screen-Shake in Frames
  let runSession: Promise<RunSession | { error: unknown } | null> = Promise.resolve(null);
  let runId = 0;
  let durationMs = 0;
  let hasResult = false;
  let starting = false;
  let lastAnnounced = 0;
  const particles: Particle[] = [];
  const popups: Popup[] = [];
  let toast: Toast | null = null;
  let displayedScore = -1;

  function show(which: keyof typeof overlays | null) {
    for (const [key, el] of Object.entries(overlays)) el.hidden = key !== which;
    // P2-16: Nur im laufenden Spiel schluckt der Canvas Wischgesten. Im Leerlauf,
    // in der Pause und nach dem Absturz scrollt das Handy wieder normal weiter.
    ROOT!.dataset.playing = which === null ? "1" : "0";
  }

  interface RunSession { token: string; expires_at: number }
  async function requestSession(): Promise<RunSession | { error: unknown }> {
    try { return await api<RunSession>('/session/start', {}, true); }
    catch (error) { return { error }; }
  }

  async function begin() {
    if (starting) return;
    starting = true;
    startBtn.disabled = true;
    restartBtn.disabled = true;
    runId += 1;
    // Der Server setzt den Beginn der wertbaren Laufzeit. Erst danach startet die Physik.
    if (contestLive) setRunMessage('Flug wird vorbereitet …');
    const session = contestLive ? await requestSession() : null;
    runSession = Promise.resolve(session);
    if (contestLive) setRunMessage(session && !('error' in session) ? '' : 'Du fliegst gerade nur lokal. Die Verbindung zur Bestenliste fehlt.');
    fitCanvas();
    startRun(state);
    paused = false;
    lastTs = 0;
    particles.length = 0;
    popups.length = 0;
    toast = null;
    shake = 0;
    lastAnnounced = 0;
    hasResult = false;
    show(null);
    if (form) {
      form.hidden = true;
      if (formMeta) formMeta.textContent = '';
    }
    starting = false;
    startBtn.disabled = false;
    restartBtn.disabled = false;
    canvas.focus({ preventScroll: true });
  }

  function tap() {
    if (paused) {
      paused = false;
      lastTs = 0;
      show(null);
      return;
    }
    if (state.phase === 'playing') tapQueued = true;
    else if (state.phase === 'idle') begin();
  }

  function onGameOver() {
    durationMs = Math.round((state.frames * 1000) / 60);
    const score = state.score;
    hasResult = true;
    finalEl.textContent = String(score);
    bestNote.hidden = !(score > best && score > 0);
    if (score > best) {
      best = score;
      bestEl.textContent = String(best);
      writeStore('pp_best', String(best));
    }
    if (overBestEl) overBestEl.textContent = String(best);
    if (soonBestEl) soonBestEl.textContent = String(best);
    rankEl.hidden = true;
    rankEl.textContent = '';
    show('over');
    announce.textContent = `Abgeschmiert bei ${score} Punkten.`;
    if (contestLive && !player && form) form.hidden = false;
    if (toFormBtn) toFormBtn.hidden = !contestLive || Boolean(player);
    if (!contestLive) { setRunMessage('Die Wochenwertung ist noch nicht gestartet. Dein Bestwert bleibt in diesem Browser.'); return; }
    const finishedRun = runSession;
    const finishedDuration = durationMs;
    void finishedRun.then((session) => {
      if (!session || 'error' in session) {
        setRunMessage(session ? errorMessage(session.error) : 'Dieser Flug bleibt nur hier gespeichert. Die Bestenliste ist gerade nicht erreichbar.');
        return;
      }
      const pending = readPending();
      pending.push({ token: session.token, score, duration_ms: finishedDuration, expires_at: session.expires_at });
      savePending(pending);
      if (player) void submitPending();
      else setRunMessage(`${score} Punkte warten auf deine Anmeldung. Bestätige die E-Mail in diesem Browser innerhalb einer Stunde.`);
    });
  }

  // ── Events aus der Engine → Effekte ───────────────────────────────────────
  function spawnParticles(x: number, y: number, n: number, colors: string[], speed: number, g: number, size: number, life: number) {
    const count = reduceMotion ? Math.ceil(n / 3) : n;
    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2;
      const v = speed * (0.4 + Math.random() * 0.8);
      particles.push({
        x, y,
        vx: Math.cos(a) * v,
        vy: Math.sin(a) * v - speed * 0.4,
        life, max: life,
        size: size * (0.6 + Math.random() * 0.8),
        color: colors[i % colors.length],
        g,
      });
    }
  }
  function splash(x: number) {
    for (let i = 0; i < (reduceMotion ? 8 : 28); i++) {
      const v = 4 + Math.random() * 7;
      particles.push({
        x: x + (Math.random() - 0.5) * 40, y: WATER_Y,
        vx: (Math.random() - 0.5) * 5, vy: -v,
        life: 50, max: 50, size: 3 + Math.random() * 4,
        color: i % 4 === 0 ? C.navyDeep : C.cream, g: 0.32,
      });
    }
  }
  function handleEvents(events: GameEvent[]) {
    for (const ev of events) {
      if (ev.type === 'tap') {
        sfx.tap();
      } else if (ev.type === 'pickup') {
        const ing = INGREDIENTS[ev.kind ?? 0];
        const col = C[ing.color] ?? C.yellow;
        spawnParticles(ev.x ?? 0, ev.y ?? 0, 10, [col, C.cream], 3.2, 0.12, 4, 28);
        popups.push({ x: ev.x ?? 0, y: (ev.y ?? 0) - 14, text: `+${ev.points ?? 10}`, life: 42, max: 42, color: col, size: 26 });
        sfx.pickup();
      } else if (ev.type === 'gull') {
        popups.push({ x: ev.x ?? 0, y: (ev.y ?? 0) - 18, text: '+1', life: 30, max: 30, color: C.cream, size: 16 });
        sfx.gull();
      } else if (ev.type === 'set') {
        toast = { text: `${ev.name} komplett · +${ev.points ?? 50}`, life: 110, max: 110 };
        spawnParticles(ev.x ?? state.player.x, ev.y ?? state.player.y, 26, [C.yellow, C.orange, C.pink, C.cream], 5, 0.14, 5, 46);
        sfx.set();
        announce.textContent = `${ev.name} komplett, plus ${ev.points ?? 50}.`;
      } else if (ev.type === 'crash') {
        shake = reduceMotion ? 0 : 26;
        spawnParticles(ev.x ?? 0, ev.y ?? 0, 18, [C.orange, C.yellow, C.cream], 5, 0.28, 5, 40);
        splash(ev.x ?? state.player.x);
        sfx.crash();
      } else if (ev.type === 'plop') {
        spawnParticles(ev.x ?? 0, WATER_Y, 5, [C.cream], 2.2, 0.28, 3, 22);
      }
    }
  }

  function updateFx(dt: number) {
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.vy += p.g * dt;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.life -= dt;
      if (p.life <= 0) particles.splice(i, 1);
    }
    for (let i = popups.length - 1; i >= 0; i--) {
      const p = popups[i];
      p.y -= 0.9 * dt;
      p.life -= dt;
      if (p.life <= 0) popups.splice(i, 1);
    }
    if (toast) {
      toast.life -= dt;
      if (toast.life <= 0) toast = null;
    }
    if (shake > 0) shake -= dt;
    propAngle += (state.phase === 'playing' ? 0.9 : 0.25) * dt;
    const drift = state.phase === 'playing' ? state.speed : reduceMotion ? 0 : 1.2;
    bg += drift * dt;
  }

  function updateHud() {
    if (state.score !== displayedScore) {
      displayedScore = state.score;
      scoreEl.textContent = String(state.score);
      if (state.score - lastAnnounced >= 50 && state.phase === 'playing') {
        lastAnnounced = state.score;
        announce.textContent = `${state.score} Punkte`;
      }
    }
    const prog = activeProgress(state) as boolean[];
    setDots.forEach((d, i) => d.classList.toggle('is-on', Boolean(prog[i])));
    const name = state.activeCreation >= 0 ? CREATIONS[state.activeCreation].name : 'Kreation';
    if (setNameEl.textContent !== name) setNameEl.textContent = name;
  }

  // ── Zeichnen ───────────────────────────────────────────────────────────────
  const skyCache = new Map<number, CanvasGradient>();
  function skyGradient(dusk: number) {
    const key = Math.round(dusk * 40);
    let g = skyCache.get(key);
    if (!g) {
      const d = key / 40;
      g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, C.navyDeep);
      g.addColorStop(lerp(0.56, 0.3, d), C.navy);
      g.addColorStop(lerp(0.88, 0.7, d), C.orange);
      g.addColorStop(1, C.yellow);
      skyCache.set(key, g);
    }
    return g;
  }

  function drawSun(w: number, dusk: number) {
    const x = w * 0.74;
    const y = lerp(WATER_Y - 96, WATER_Y - 30, dusk);
    const r = 44;
    const glow = ctx.createRadialGradient(x, y, r * 0.6, x, y, r * 2.6);
    glow.addColorStop(0, 'rgba(245,197,24,0.35)');
    glow.addColorStop(1, 'rgba(245,197,24,0)');
    ctx.fillStyle = glow;
    ctx.fillRect(x - r * 3, y - r * 3, r * 6, r * 6);
    ctx.fillStyle = C.yellow;
    ctx.globalAlpha = 0.92;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  // Ferne Bremerhaven-Silhouette: Klimahaus-Bogen, Sail City, Hafenkräne, Zoo-Kuppel, Radarturm, Blöcke.
  const SKY_TILE = 1400;
  function drawSkylineTile(ox: number) {
    const base = WATER_Y + 1;
    ctx.beginPath();
    // Blöcke Stadt
    const blocks = [[0, 90, 42], [100, 50, 30], [160, 70, 58], [240, 40, 36], [560, 60, 40], [630, 90, 52], [730, 50, 34], [980, 80, 44], [1070, 46, 28], [1300, 70, 38]];
    for (const [bx, bw, bh] of blocks) ctx.rect(ox + bx, base - bh, bw, bh);
    // Sail City (Turm mit Segelspitze)
    ctx.moveTo(ox + 300, base);
    ctx.lineTo(ox + 300, base - 120);
    ctx.lineTo(ox + 316, base - 150);
    ctx.lineTo(ox + 330, base - 120);
    ctx.lineTo(ox + 330, base);
    ctx.closePath();
    // Klimahaus (Rumpf-Bogen)
    ctx.moveTo(ox + 370, base);
    ctx.bezierCurveTo(ox + 380, base - 62, ox + 500, base - 62, ox + 520, base);
    ctx.closePath();
    // Zoo-Kuppel
    ctx.moveTo(ox + 800, base);
    ctx.arc(ox + 830, base, 30, Math.PI, 0);
    ctx.closePath();
    // Radarturm
    ctx.rect(ox + 900, base - 100, 4, 100);
    ctx.moveTo(ox + 910, base - 106);
    ctx.arc(ox + 902, base - 106, 8, 0, Math.PI * 2);
    ctx.fill();
    // Hafenkräne (Linien)
    ctx.lineWidth = 3;
    ctx.beginPath();
    for (const cx of [1140, 1200, 1250]) {
      ctx.moveTo(ox + cx, base);
      ctx.lineTo(ox + cx, base - 96);
      ctx.lineTo(ox + cx + 54, base - 96);
      ctx.moveTo(ox + cx, base - 70);
      ctx.lineTo(ox + cx + 54, base - 96);
      ctx.moveTo(ox + cx + 44, base - 96);
      ctx.lineTo(ox + cx + 44, base - 60);
    }
    ctx.stroke();
  }
  function drawSkyline(w: number) {
    ctx.save();
    ctx.globalAlpha = 0.1;
    ctx.fillStyle = C.cream;
    ctx.strokeStyle = C.cream;
    const off = -((bg * 0.15) % SKY_TILE);
    for (let x = off; x < w + SKY_TILE; x += SKY_TILE) drawSkylineTile(x);
    ctx.restore();
  }

  function puff(x: number, y: number, r: number) {
    ctx.moveTo(x + r, y);
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.moveTo(x + r * 1.7, y + r * 0.2);
    ctx.arc(x + r * 0.9, y + r * 0.2, r * 0.8, 0, Math.PI * 2);
    ctx.moveTo(x - r * 0.2, y + r * 0.3);
    ctx.arc(x - r * 0.9, y + r * 0.3, r * 0.7, 0, Math.PI * 2);
  }
  function drawMidClouds(w: number) {
    ctx.save();
    ctx.globalAlpha = 0.16;
    ctx.fillStyle = C.cream;
    ctx.beginPath();
    const tile = 900;
    const off = -((bg * 0.4) % tile);
    for (let x = off; x < w + tile; x += tile) {
      puff(x + 80, 150, 30);
      puff(x + 380, 210, 24);
      puff(x + 640, 120, 34);
    }
    ctx.fill();
    ctx.restore();
  }
  function drawCloudDeck(w: number) {
    ctx.save();
    ctx.fillStyle = C.cream;
    ctx.globalAlpha = 0.94;
    ctx.fillRect(0, 0, w, CEIL_Y - 22);
    ctx.beginPath();
    const tile = 200;
    const off = -((bg * 0.6) % tile);
    for (let x = off - tile; x < w + tile; x += tile) {
      puff(x + 40, CEIL_Y - 24, 26);
      puff(x + 130, CEIL_Y - 30, 22);
    }
    ctx.fill();
    ctx.globalAlpha = 0.35;
    ctx.fillStyle = C.navy;
    ctx.beginPath();
    for (let x = off - tile; x < w + tile; x += tile) {
      ctx.moveTo(x + 66, CEIL_Y - 12);
      ctx.arc(x + 40, CEIL_Y - 12, 26, 0.15, Math.PI - 0.15);
      ctx.moveTo(x + 152, CEIL_Y - 18);
      ctx.arc(x + 130, CEIL_Y - 18, 22, 0.15, Math.PI - 0.15);
    }
    ctx.fill();
    ctx.restore();
  }

  function drawWater(w: number) {
    ctx.save();
    ctx.fillStyle = C.navyDeep;
    ctx.fillRect(0, WATER_Y, w, H - WATER_Y);
    ctx.strokeStyle = C.cream;
    ctx.lineWidth = 2;
    const rows = [[8, 0.55, 1.0], [24, 0.3, 0.8], [42, 0.16, 0.6]];
    for (const [dy, alpha, par] of rows) {
      ctx.globalAlpha = alpha;
      ctx.beginPath();
      const phase = bg * par * 0.08 + state.frames * 0.03;
      for (let x = -20; x <= w + 20; x += 8) {
        const y = WATER_Y + dy + Math.sin(x * 0.045 + phase) * 3 + Math.sin(x * 0.11 - phase * 1.3) * 1.5;
        if (x === -20) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    ctx.globalAlpha = 0.6;
    ctx.fillStyle = C.orange;
    ctx.fillRect(0, WATER_Y - 1, w, 1.5);
    ctx.restore();
  }

  function drawIngredient(i: Ing) {
    const ing = INGREDIENTS[i.kind];
    const col = C[ing.color] ?? C.yellow;
    const r = GLYPH / 2;
    const bob = Math.sin(i.spin) * 2;
    ctx.save();
    ctx.translate(i.x, i.y + bob);
    ctx.fillStyle = 'rgba(14,24,37,0.82)';
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.lineWidth = 2.5;
    ctx.strokeStyle = col;
    ctx.stroke();
    ctx.fillStyle = col;
    ctx.strokeStyle = C.navyDeep;
    drawShape(ing.shape, ing.id, col);
    ctx.restore();
    // Buchstabentag (Mono) unter dem Badge
    ctx.save();
    ctx.font = `700 13px ${FONT_MONO}`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    const tw = ctx.measureText(ing.tag).width + 8;
    ctx.fillStyle = 'rgba(14,24,37,0.85)';
    ctx.fillRect(i.x - tw / 2, i.y + bob + r + 3, tw, 15);
    ctx.fillStyle = C.cream;
    ctx.fillText(ing.tag, i.x, i.y + bob + r + 11);
    ctx.restore();
  }

  function drawShape(shape: string, id: string, col: string) {
    const s = 10;
    ctx.lineWidth = 1.5;
    switch (shape) {
      case 'chili': {
        ctx.beginPath();
        ctx.moveTo(-9, -6);
        ctx.quadraticCurveTo(10, -10, 9, 4);
        ctx.quadraticCurveTo(6, 10, -2, 6);
        ctx.quadraticCurveTo(-8, 2, -9, -6);
        ctx.fill();
        ctx.fillStyle = id === 'chili' ? C.green : C.cream;
        ctx.fillRect(-11, -9, 5, 4);
        break;
      }
      case 'corn': {
        ctx.beginPath();
        ctx.arc(0, 0, s, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = C.navyDeep;
        for (const [dx, dy] of [[-4, -3], [4, -3], [0, 4]]) {
          ctx.beginPath();
          ctx.arc(dx, dy, 2, 0, Math.PI * 2);
          ctx.fill();
        }
        break;
      }
      case 'triangle': {
        ctx.beginPath();
        ctx.moveTo(-10, -8);
        ctx.lineTo(10, -8);
        ctx.lineTo(0, 10);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = C.orange;
        ctx.fillRect(-3, -4, 2, 2);
        ctx.fillRect(3, -2, 2, 2);
        ctx.fillRect(-1, 3, 2, 2);
        break;
      }
      case 'oval': {
        ctx.beginPath();
        ctx.ellipse(0, 0, 11, 7, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = C.navyDeep;
        ctx.beginPath();
        ctx.moveTo(-6, -3); ctx.lineTo(-4, 3);
        ctx.moveTo(0, -4); ctx.lineTo(2, 4);
        ctx.moveTo(6, -3); ctx.lineTo(7, 3);
        ctx.stroke();
        break;
      }
      case 'cube': {
        ctx.save();
        ctx.rotate(0.18);
        ctx.fillRect(-8, -8, 16, 16);
        ctx.fillStyle = C.creamWarm;
        ctx.fillRect(-8, 2, 16, 6);
        ctx.strokeStyle = C.navyDeep;
        ctx.strokeRect(-8, -8, 16, 16);
        ctx.restore();
        break;
      }
      case 'seeds': {
        ctx.beginPath();
        ctx.arc(0, 0, s, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = C.cream;
        for (const [dx, dy] of [[-4, -4], [4, -4], [-4, 4], [4, 4], [0, 0]]) {
          ctx.beginPath();
          ctx.arc(dx, dy, 1.8, 0, Math.PI * 2);
          ctx.fill();
        }
        break;
      }
      case 'blob': {
        ctx.beginPath();
        ctx.moveTo(-9, -3);
        ctx.lineTo(-4, -10);
        ctx.lineTo(5, -8);
        ctx.lineTo(10, -1);
        ctx.lineTo(7, 8);
        ctx.lineTo(-3, 10);
        ctx.lineTo(-10, 5);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = C.yellow;
        ctx.fillRect(-3, -5, 4, 3);
        break;
      }
      case 'dots': {
        ctx.fillStyle = C.navy;
        ctx.beginPath();
        ctx.arc(0, 0, s, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = col;
        for (const [dx, dy] of [[-5, -2], [0, -5], [5, -2], [-3, 4], [3, 4]]) {
          ctx.beginPath();
          ctx.ellipse(dx, dy, 2.6, 1.7, 0.6, 0, Math.PI * 2);
          ctx.fill();
        }
        break;
      }
      case 'ring': {
        ctx.lineWidth = 5;
        ctx.strokeStyle = col;
        ctx.beginPath();
        ctx.arc(0, 0, 8, 0, Math.PI * 2);
        ctx.stroke();
        if (id === 'roestzwiebel') {
          ctx.lineWidth = 1.5;
          ctx.strokeStyle = C.orange;
          ctx.beginPath();
          ctx.arc(0, 0, 8, 0.3, 1.4);
          ctx.arc(0, 0, 8, 2.8, 3.9);
          ctx.stroke();
        }
        break;
      }
      case 'crescent': {
        ctx.beginPath();
        ctx.arc(0, 2, 10, Math.PI * 1.05, Math.PI * 1.95);
        ctx.arc(0, -3, 7, Math.PI * 1.95, Math.PI * 1.05, true);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = C.cream;
        ctx.beginPath();
        ctx.moveTo(-4, -6); ctx.lineTo(-3, -1);
        ctx.moveTo(1, -7); ctx.lineTo(1, -2);
        ctx.moveTo(6, -5); ctx.lineTo(5, 0);
        ctx.stroke();
        break;
      }
      case 'leaf': {
        if (id === 'gruenkohl') {
          ctx.beginPath();
          for (let k = 0; k < 7; k++) {
            const a = (k / 7) * Math.PI * 2;
            ctx.moveTo(Math.cos(a) * 9, Math.sin(a) * 9);
            ctx.arc(Math.cos(a) * 6, Math.sin(a) * 6, 4.5, 0, Math.PI * 2);
          }
          ctx.fill();
          ctx.fillStyle = C.navyDeep;
          ctx.beginPath();
          ctx.arc(0, 0, 2, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.strokeStyle = col;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(0, 10); ctx.lineTo(0, -9);
          for (const [y, dx] of [[-6, 6], [-2, 7], [2, 6], [6, 4]]) {
            ctx.moveTo(0, y); ctx.lineTo(-dx, y - 4);
            ctx.moveTo(0, y); ctx.lineTo(dx, y - 4);
          }
          ctx.stroke();
        }
        break;
      }
      case 'wedge': {
        ctx.beginPath();
        ctx.arc(0, 2, 10, Math.PI, 0);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = C.creamWarm;
        ctx.beginPath();
        ctx.arc(0, 2, 7, Math.PI, 0);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = col;
        ctx.beginPath();
        for (const a of [-2.6, -2.1, -1.57, -1.05, -0.5]) {
          ctx.moveTo(0, 2);
          ctx.lineTo(Math.cos(a) * 7, 2 + Math.sin(a) * 7);
        }
        ctx.stroke();
        break;
      }
      case 'sausage': {
        ctx.beginPath();
        ctx.moveTo(-9, 2);
        ctx.quadraticCurveTo(0, -8, 9, 2);
        ctx.quadraticCurveTo(0, 8, -9, 2);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = C.cream;
        ctx.fillRect(-11, 0, 3, 3);
        ctx.fillRect(8, 0, 3, 3);
        break;
      }
      case 'drop':
      default: {
        ctx.beginPath();
        ctx.moveTo(0, -11);
        ctx.bezierCurveTo(7, -2, 9, 3, 9, 4);
        ctx.arc(0, 4, 9, 0, Math.PI, false);
        ctx.bezierCurveTo(-9, 3, -7, -2, 0, -11);
        ctx.fill();
        ctx.fillStyle = C.cream;
        ctx.beginPath();
        ctx.arc(-3, 4, 2, 0, Math.PI * 2);
        ctx.fill();
        break;
      }
    }
  }

  function drawBlob(b: BlobItem) {
    ctx.save();
    ctx.translate(b.x, b.y);
    ctx.rotate(Math.sin(b.wobble) * 0.12);
    ctx.fillStyle = C.orange;
    ctx.beginPath();
    ctx.moveTo(0, -BLOB_R - 8);
    ctx.bezierCurveTo(BLOB_R, -2, BLOB_R, 4, BLOB_R, 5);
    ctx.arc(0, 5, BLOB_R, 0, Math.PI, false);
    ctx.bezierCurveTo(-BLOB_R, 4, -BLOB_R, -2, 0, -BLOB_R - 8);
    ctx.fill();
    ctx.fillStyle = 'rgba(245,240,225,0.6)';
    ctx.beginPath();
    ctx.arc(-4, 3, 3, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  function drawGull(g: Gull) {
    const flap = Math.sin(g.phase);
    ctx.save();
    ctx.translate(g.x, g.y);
    ctx.strokeStyle = C.cream;
    ctx.fillStyle = C.cream;
    ctx.lineWidth = 3.5;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(-26, -4 - flap * 9);
    ctx.quadraticCurveTo(-13, -12 - flap * 6, 0, 0);
    ctx.quadraticCurveTo(13, -12 - flap * 6, 26, -4 - flap * 9);
    ctx.stroke();
    ctx.beginPath();
    ctx.ellipse(2, 2, 11, 5, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(-11, 0, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = C.orange;
    ctx.beginPath();
    ctx.moveTo(-15, -1);
    ctx.lineTo(-20, 1);
    ctx.lineTo(-15, 2);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = C.navyDeep;
    ctx.beginPath();
    ctx.arc(-12, -1, 1, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  function drawPlane() {
    const p = state.player;
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(p.angle);
    // Flügel hinten (Navy)
    ctx.fillStyle = C.navy;
    ctx.beginPath();
    ctx.ellipse(-2, 8, 15, 5, 0.05, 0, Math.PI * 2);
    ctx.fill();
    // Heckflosse
    ctx.beginPath();
    ctx.moveTo(-30, -2);
    ctx.lineTo(-22, -18);
    ctx.lineTo(-14, -2);
    ctx.closePath();
    ctx.fill();
    // Rumpf (Cream, Navy-Umriss)
    ctx.fillStyle = C.cream;
    ctx.strokeStyle = C.navy;
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(-32, -4);
    ctx.quadraticCurveTo(-10, -14, 22, -9);
    ctx.quadraticCurveTo(34, -6, 34, 0);
    ctx.quadraticCurveTo(34, 8, 22, 9);
    ctx.quadraticCurveTo(-10, 12, -32, 6);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    // Orange Streifen
    ctx.fillStyle = C.orange;
    ctx.fillRect(-14, 1, 30, 3);
    // Kanzel-Ausschnitt
    ctx.fillStyle = C.navy;
    ctx.beginPath();
    ctx.moveTo(-6, -8);
    ctx.lineTo(16, -9);
    ctx.lineTo(16, -2);
    ctx.lineTo(-6, -2);
    ctx.closePath();
    ctx.fill();
    // Pommestüte als Pilot: Becher, Fritten, Kapitänsmütze
    ctx.fillStyle = C.cream;
    ctx.beginPath();
    ctx.moveTo(-1, -8);
    ctx.lineTo(11, -8);
    ctx.lineTo(9, -1);
    ctx.lineTo(1, -1);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = C.orange;
    ctx.fillRect(1, -6, 2, 4);
    ctx.fillRect(5, -6, 2, 4);
    ctx.fillStyle = C.yellow;
    for (const [dx, h] of [[1, 11], [4, 14], [7, 12]]) ctx.fillRect(dx, -8 - h, 2.4, h);
    ctx.fillStyle = C.navy;
    ctx.fillRect(-2, -24, 14, 4);
    ctx.fillRect(0, -27, 10, 4);
    ctx.fillStyle = C.yellow;
    ctx.fillRect(4, -25, 3, 2);
    // Windschutz
    ctx.strokeStyle = C.navy;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(14, -9);
    ctx.lineTo(20, -18);
    ctx.stroke();
    // Flügel vorne (Navy)
    ctx.fillStyle = C.navy;
    ctx.beginPath();
    ctx.ellipse(2, 5, 17, 5, -0.05, 0, Math.PI * 2);
    ctx.fill();
    // Propeller
    ctx.fillStyle = C.orange;
    ctx.beginPath();
    ctx.arc(35, 0, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = C.orange;
    ctx.globalAlpha = 0.85;
    ctx.lineWidth = 3;
    const bl = 20 * Math.abs(Math.cos(propAngle));
    ctx.beginPath();
    ctx.moveTo(36, -bl);
    ctx.lineTo(36, bl);
    ctx.stroke();
    ctx.globalAlpha = 0.25;
    ctx.beginPath();
    ctx.moveTo(36, -20);
    ctx.lineTo(36, 20);
    ctx.stroke();
    ctx.restore();
  }

  function drawFx() {
    for (const p of particles) {
      ctx.globalAlpha = clamp(p.life / p.max, 0, 1);
      ctx.fillStyle = p.color;
      ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
    }
    ctx.globalAlpha = 1;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    for (const p of popups) {
      const t = clamp(p.life / p.max, 0, 1);
      ctx.globalAlpha = t < 0.4 ? t / 0.4 : 1;
      ctx.font = `${p.size}px ${FONT_DISPLAY}`;
      ctx.lineWidth = 4;
      ctx.strokeStyle = C.navyDeep;
      ctx.strokeText(p.text, p.x, p.y);
      ctx.fillStyle = p.color;
      ctx.fillText(p.text, p.x, p.y);
    }
    ctx.globalAlpha = 1;
  }

  function drawToast(w: number) {
    if (!toast) return;
    const t = toast.life / toast.max;
    const a = t > 0.85 ? (1 - t) / 0.15 : t < 0.2 ? t / 0.2 : 1;
    ctx.save();
    ctx.globalAlpha = a;
    ctx.font = `22px ${FONT_DISPLAY}`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    const text = toast.text.toUpperCase();
    const tw = Math.min(w - 24, ctx.measureText(text).width + 36);
    const x = w / 2;
    const y = CEIL_Y + 58;
    ctx.fillStyle = C.navy;
    ctx.fillRect(x - tw / 2, y - 20, tw, 40);
    ctx.strokeStyle = C.orange;
    ctx.lineWidth = 2;
    ctx.strokeRect(x - tw / 2, y - 20, tw, 40);
    ctx.fillStyle = C.cream;
    ctx.fillText(text, x, y + 1, w - 60);
    ctx.restore();
  }

  function draw() {
    const w = state.w;
    const dusk = clamp(state.score / 300, 0, 1);
    let sx = 0;
    let sy = 0;
    if (shake > 0) {
      const amp = (shake / 26) * 9;
      sx = (Math.random() - 0.5) * amp;
      sy = (Math.random() - 0.5) * amp;
    }
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.fillStyle = C.navyDeep;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.save();
    ctx.setTransform(scale, 0, 0, scale, offsetX + sx * scale, sy * scale);
    ctx.beginPath();
    ctx.rect(0, 0, w, H);
    ctx.clip();

    ctx.fillStyle = skyGradient(dusk);
    ctx.fillRect(0, 0, w, H);
    drawSun(w, dusk);
    drawSkyline(w);
    drawMidClouds(w);
    for (const i of state.ingredients) drawIngredient(i);
    for (const b of state.blobs) drawBlob(b);
    for (const g of state.gulls) drawGull(g);
    if (state.phase !== 'over' || state.player.y < WATER_Y + 20) drawPlane();
    drawWater(w);
    drawCloudDeck(w);
    drawFx();
    drawToast(w);
    ctx.restore();
  }

  // ── Loop ───────────────────────────────────────────────────────────────────
  function frame(ts: number) {
    if (document.hidden) {
      lastTs = 0;
      requestAnimationFrame(frame);
      return;
    }
    if (!lastTs) lastTs = ts;
    const dt = Math.min((ts - lastTs) / (1000 / 60), 2.5);
    lastTs = ts;
    if (!paused) {
      const before = state.phase;
      step(state, dt, { tap: tapQueued });
      tapQueued = false;
      handleEvents(drainEvents(state) as GameEvent[]);
      if (before !== 'over' && state.phase === 'over') onGameOver();
    }
    updateFx(dt);
    updateHud();
    draw();
    requestAnimationFrame(frame);
  }

  // ── Eingabe ────────────────────────────────────────────────────────────────
  startBtn.addEventListener('click', begin);
  restartBtn.addEventListener('click', begin);
  canvas.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    tap();
  });
  canvas.addEventListener('contextmenu', (e) => e.preventDefault());
  window.addEventListener('keydown', (e) => {
    if (e.code !== 'Space') return;
    const t = e.target as HTMLElement | null;
    if (
      t instanceof HTMLInputElement ||
      t instanceof HTMLTextAreaElement ||
      t instanceof HTMLButtonElement ||
      t instanceof HTMLSelectElement ||
      t instanceof HTMLAnchorElement ||
      (t && t.isContentEditable)
    ) return;
    // P2-05: Im Leerlauf startet die Leertaste nur, wenn das Spielfeld den Fokus hat.
    // Sonst sprang das Spiel an, während jemand weiter unten auf der Seite las.
    if (state.phase === 'idle' && document.activeElement !== canvas) return;
    if (state.phase === 'over' && !paused) return;
    e.preventDefault();
    if (!e.repeat) tap();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && state.phase === 'playing' && !paused) {
      paused = true;
      show('pause');
    }
  });
  // Einmalige E-Mail-Anmeldung. Auth-Token bleibt 30 Tage lokal; Runs maximal eine Stunde.
  interface Player { display_name: string; masked_email: string; eligible_to_win: boolean; eligible_after: number | null }
  interface AuthResult { ok: boolean; token?: string; expires_at: number; player: Player }
  interface PendingRun { token: string; score: number; duration_ms: number; expires_at: number }
  interface ScoreResult { ok: boolean; rank: number; total: number; best_score: number; improved: boolean; eligible_to_win: boolean; eligible_after: number | null }
  const AUTH_KEY = 'pp_player_token';
  const PENDING_KEY = 'pp_pending_runs';
  let authToken = readStore(AUTH_KEY) ?? '';
  let player: Player | null = null;
  let authRevision = 0;
  let submitting = false;
  let pendingMemory: PendingRun[] = [];
  let authReady = false;

  class ApiError extends Error {
    constructor(public code: string, public status: number) { super(code); }
  }
  async function api<T>(path: string, body?: unknown, authenticated = false): Promise<T> {
    const headers: Record<string, string> = {};
    if (body !== undefined) headers['Content-Type'] = 'application/json';
    if (authenticated && authToken) headers.Authorization = `Bearer ${authToken}`;
    const res = await fetch(`${apiBase}${path}`, {
      method: body === undefined ? 'GET' : 'POST', headers,
      body: body === undefined ? undefined : JSON.stringify(body),
      cache: 'no-store', signal: AbortSignal.timeout(12000),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.ok === false) throw new ApiError(String(data.error ?? 'unavailable'), res.status);
    return data as T;
  }
  function errorMessage(error: unknown): string {
    if (!(error instanceof ApiError)) return 'Verbindung fehlgeschlagen. Bitte versuch es gleich noch einmal.';
    const messages: Record<string, string> = {
      invalid_email: 'Bitte prüfe deine E-Mail-Adresse.',
      invalid_name: 'Bitte wähle einen öffentlichen Namen mit höchstens 32 Zeichen.',
      consent_required: 'Bitte bestätige die Spielregeln und Datenschutzhinweise.',
      age_required: 'Die Bestenliste ist ab 18 Jahren. Bitte bestätige dein Alter.',
      terms_changed: 'Die Spielregeln wurden aktualisiert. Lade die Seite neu und bestätige sie erneut.',
      auth_required: 'Bitte melde dich an, damit dein Score zählt.',
      auth_invalid: 'Deine Anmeldung ist abgelaufen. Bitte bestätige einen neuen E-Mail-Link.',
      auth_link_expired: 'Dieser Link ist abgelaufen. Fordere einen neuen Anmeldelink an.',
      auth_link_used: 'Dieser Link wurde schon verwendet. Melde dich bei Bedarf mit einem neuen Link an.',
      session_expired: 'Dieser Flug ist abgelaufen. Flieg eine neue Runde.',
      run_conflict: 'Dieser Flug wurde bereits anders eingereicht. Flieg eine neue Runde.',
      week_closed: 'Die Woche dieses Flugs ist abgeschlossen. Deine nächste Runde zählt für diese Woche.',
      invalid_duration: 'Dieser Flug war zu kurz oder konnte nicht gewertet werden. Versuch es noch einmal.',
      invalid_score: 'Dieser Score konnte nicht gewertet werden. Flieg eine neue Runde.',
      score_implausible: 'Dieser Flug konnte nicht gewertet werden. Flieg eine neue Runde.',
      rate_limited: 'Gerade zu viele Versuche. Warte kurz, bevor du es noch einmal probierst.',
      mail_unavailable: 'Der Anmeldelink kann gerade nicht verschickt werden. Du kannst als Gast weiterspielen.',
      contest_unavailable: 'Anmeldung und Scoreabgabe sind noch nicht verfügbar. Du kannst als Gast weiterspielen.',
    };
    return messages[error.code] ?? 'Das hat gerade nicht geklappt. Bitte versuch es noch einmal.';
  }
  function readPending(): PendingRun[] {
    const raw = readStore(PENDING_KEY);
    try {
      if (raw) pendingMemory = JSON.parse(raw);
    } catch { pendingMemory = []; }
    if (!Array.isArray(pendingMemory)) pendingMemory = [];
    pendingMemory = pendingMemory.filter(run => run && typeof run.token === 'string' && Number.isFinite(run.score) && Number.isFinite(run.duration_ms) && Number(run.expires_at) > Date.now());
    const clean = JSON.stringify(pendingMemory);
    if (raw && raw !== clean) writeStore(PENDING_KEY, clean);
    return pendingMemory;
  }
  function savePending(runs: PendingRun[]) {
    pendingMemory = runs;
    writeStore(PENDING_KEY, JSON.stringify(runs));
  }
  function setRunMessage(message: string) {
    runStatus.textContent = message;
    if (hasResult) { rankEl.textContent = message; rankEl.hidden = false; }
  }
  function applyPlayer() {
    loginToggle.disabled = !contestLive;
    loginToggle.textContent = contestLive ? 'Anmelden' : 'Anmeldung folgt';
    loginToggle.hidden = Boolean(player);
    logoutBtn.hidden = !authToken;
    if (toFormBtn) toFormBtn.hidden = !contestLive || Boolean(player);
    if (player) {
      const eligible = player.eligible_to_win || !player.eligible_after ? '' : ` Wieder gewinnen kannst du ab ${new Date(player.eligible_after).toLocaleDateString('de-DE')}.`;
      playerState.textContent = `Du fliegst als ${player.display_name}. ${contestLive ? 'Deine Scores zählen automatisch.' : 'Die Wochenwertung ist noch nicht gestartet.'}${eligible}`;
      if (form) form.hidden = true;
    } else playerState.textContent = contestLive ? 'Als Gast fliegen oder mit eigenem Namen in die Bestenliste.' : 'Gastspiel ist offen. Die Anmeldung zur Wochenwertung folgt.';
  }
  function openLogin() {
    if (!form || !contestLive) return;
    form.hidden = false;
    form.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    form.querySelector<HTMLInputElement>('[name="display_name"]')?.focus({ preventScroll: true });
  }
  loginToggle.addEventListener('click', openLogin);
  toFormBtn?.addEventListener('click', openLogin);
  q<HTMLButtonElement>('[data-login-cancel]')?.addEventListener('click', () => {
    if (form) form.hidden = true;
    canvas.focus({ preventScroll: true });
  });

  async function refreshAuth() {
    const revision = ++authRevision;
    authReady = false;
    if (!authToken) { player = null; applyPlayer(); authReady = true; return; }
    playerState.textContent = 'Anmeldung wird geprüft …';
    try {
      const data = await api<AuthResult>('/auth/me', undefined, true);
      if (revision !== authRevision) return;
      player = data.player;
      applyPlayer();
    } catch (error) {
      if (revision !== authRevision) return;
      player = null;
      if (error instanceof ApiError && error.status === 401) {
        authToken = ''; writeStore(AUTH_KEY, '');
      }
      applyPlayer();
      setRunMessage(errorMessage(error));
    } finally {
      if (revision === authRevision) { authReady = true; if (player) void submitPending(); }
    }
  }
  async function submitPending() {
    if (submitting || !player || !authReady) return;
    submitting = true;
    const activeToken = authToken;
    try {
      retryScore.hidden = true;
      while (readPending().length) {
        const run = readPending()[0];
        if (!player || authToken !== activeToken) break;
        setRunMessage(`${run.score} Punkte werden eingetragen …`);
        try {
          const data = await api<ScoreResult>('/score/submit', { token: run.token, score: run.score, duration_ms: run.duration_ms }, true);
          savePending(readPending().filter(item => item.token !== run.token));
          if (authToken !== activeToken || !player) break;
          player.eligible_to_win = data.eligible_to_win;
          player.eligible_after = data.eligible_after;
          applyPlayer();
          const rank = data.rank ? ` Platz ${data.rank} diese Woche.` : '';
          setRunMessage(data.improved ? `${data.best_score} Punkte stehen in der Bestenliste.${rank}` : `Flug gespeichert. Dein Bestwert bleibt ${data.best_score}.${rank}`);
          window.dispatchEvent(new CustomEvent('leaderboard:refresh'));
        } catch (error) {
          if (authToken !== activeToken) break;
          setRunMessage(errorMessage(error));
          if (error instanceof ApiError && error.status === 401) {
            player = null; authToken = ''; writeStore(AUTH_KEY, ''); applyPlayer();
            if (form && contestLive) form.hidden = false;
            break;
          }
          if (error instanceof ApiError && [409, 410, 422].includes(error.status)) {
            savePending(readPending().filter(item => item.token !== run.token));
            continue;
          }
          setRunMessage(errorMessage(error) + ' Dein Flug wartet hier. Sobald die Verbindung wieder da ist, versuchen wir es erneut.');
          retryScore.hidden = false;
          break;
        }
      }
    } finally { submitting = false; }
  }
  retryScore.addEventListener('click', () => { if (player) void submitPending(); else if (authToken) void refreshAuth(); else openLogin(); });
  logoutBtn.addEventListener('click', async () => {
    const token = authToken;
    ++authRevision;
    authToken = ''; player = null; writeStore(AUTH_KEY, ''); savePending([]);
    retryScore.hidden = true;
    applyPlayer(); setRunMessage('Du bist in diesem Browser abgemeldet.');
    try {
      const response = await fetch(`${apiBase}/auth/logout`, { method: 'POST', headers: { Authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(12000) });
      if (!response.ok) throw new Error('logout unavailable');
    } catch { /* Lokal bereits abgemeldet; serverseitiges Token läuft regulär ab. */ }
  });

  if (form && submitBtn && formMeta) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (String(data.get('website') ?? '').trim()) return;
      submitBtn.disabled = true;
      formMeta.textContent = 'Anmeldelink wird verschickt …';
      try {
        const result = await api<{ ok: boolean; mail_sent: boolean; masked_email: string }>('/auth/start', {
          email: String(data.get('email') ?? '').trim(), display_name: String(data.get('display_name') ?? '').trim(),
          consent: data.get('terms') === 'on', age_confirmed: data.get('age') === 'on', terms_version: termsVersion,
        });
        if (!result.mail_sent) throw new ApiError('mail_unavailable', 503);
        formMeta.textContent = `Schau in dein Postfach ${result.masked_email}. Bestätige den Link einmal in diesem Browser. Dein ausstehender Flug wird danach automatisch eingetragen.`;
      } catch (error) { formMeta.textContent = errorMessage(error); }
      finally { submitBtn.disabled = false; }
    });
  }

  async function initAuth() {
    const fragment = new URLSearchParams(location.hash.slice(1));
    const loginToken = fragment.get('login');
    if (!loginToken) { await refreshAuth(); return; }
    fragment.delete('login');
    history.replaceState(null, '', `${location.pathname}${location.search}${fragment.size ? '#' + fragment.toString() : ''}`);
    const revision = ++authRevision;
    setRunMessage('E-Mail wird bestätigt …');
    try {
      const result = await api<AuthResult>('/auth/verify', { token: loginToken });
      if (revision !== authRevision || !result.token) return;
      authToken = result.token; writeStore(AUTH_KEY, authToken); player = result.player; authReady = true;
      applyPlayer(); setRunMessage('Du bist angemeldet. Deine Flüge zählen jetzt automatisch.');
      await submitPending();
    } catch (error) {
      if (revision !== authRevision) return;
      authReady = true; setRunMessage(errorMessage(error));
      if (form && contestLive) form.hidden = false;
      await refreshAuth();
    }
  }
  window.addEventListener('storage', (event) => {
    if (event.key === AUTH_KEY) { authToken = readStore(AUTH_KEY) ?? ''; void refreshAuth(); }
  });
  window.addEventListener('online', () => { if (player) void submitPending(); else if (authToken) void refreshAuth(); });
  window.addEventListener('focus', () => { if (player) void submitPending(); else if (authToken) void refreshAuth(); });
  readPending();
  void initAuth();


  // ── Start ──────────────────────────────────────────────────────────────────
  fitCanvas();
  window.addEventListener('resize', fitCanvas);
  if (typeof ResizeObserver === 'function') new ResizeObserver(() => fitCanvas()).observe(stage);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => draw()).catch(() => {});
  show('idle');
  draw();
  requestAnimationFrame(frame);
</script>

