---
import FloatingMascot from "./FloatingMascot.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  status: "coming-soon" | "live" | "paused";
  launch_target: string;
  headline: string;
  sub?: string;
  lead: string;
  skus: CollectionEntry<"pantry-skus">[];
}

const { status, launch_target, headline, sub, lead, skus } = Astro.props;
const sorted = [...skus].sort((a, b) => a.data.order - b.data.order);

const statusLabel: Record<Props["status"], string> = {
  "coming-soon": "Coming Soon",
  "live": "Live",
  "paused": "Pausiert",
};
---
<section id="pantry" class="pantry has-mascot">
  <FloatingMascot
    image="04_Cheese_Fries.png"
    size={130}
    rotate={-9}
    top="22%"
    right="5%"
  />
  <div class="row">
    <div class="lead-block">
      <span class="eyebrow">Pantry · {statusLabel[status]} · {launch_target}</span>
      <h2>
        {headline}{sub && <><br /><span class="sub">{sub}</span></>}
      </h2>
      <p class="lead">{lead}</p>
      <a href="#newsletter" class="cta">Auf Waitlist sichern →</a>
    </div>

    <ul class="jars" role="list">
      {sorted.map((sku) => (
        <li class={`jar jar-${sku.data.color}`}>
          <div class="num">{sku.data.number} · {sku.data.name.toUpperCase()}</div>
          <div class="nickname">{sku.data.nickname ?? sku.data.name}</div>
          <div class="desc">{sku.data.desc_short}</div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pantry {
    padding: var(--space-9) var(--space-6);
  }

  .row {
    max-width: var(--container-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .lead-block {
    display: grid;
    gap: var(--space-4);
    max-width: 56ch;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.65;
  }

  h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.02;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  h2 .sub {
    color: var(--accent);
  }

  .lead {
    font-family: var(--font-body);
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--ink);
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    padding: var(--space-3) 0;
    border-bottom: 2px solid var(--accent);
    align-self: start;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .cta:hover,
  .cta:focus-visible {
    transform: translateY(-2px);
  }

  .jars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .jar {
    background: var(--cream);
    border-radius: var(--r-md);
    padding: var(--space-6) var(--space-4);
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-height: 220px;
    border-top: 6px solid var(--jar-accent, var(--accent));
    box-shadow:
      0 1px 0 color-mix(in oklab, var(--ink) 8%, transparent),
      0 12px 24px color-mix(in oklab, var(--ink) 8%, transparent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .jar:hover { transform: translateY(-3px); }

  .jar-pink    { --jar-accent: var(--pink); }
  .jar-green   { --jar-accent: var(--green); }
  .jar-yellow  { --jar-accent: var(--yellow); }
  .jar-orange  { --jar-accent: var(--orange); }
  .jar-navy    { --jar-accent: var(--navy); }
  .jar-cream   { --jar-accent: color-mix(in oklab, var(--ink) 20%, transparent); }

  .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--ink);
    opacity: 0.7;
  }

  .nickname {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink);
    opacity: 0.78;
  }

  @media (max-width: 900px) {
    .row { grid-template-columns: 1fr; }
    .jars { grid-template-columns: 1fr; }
    .jar { min-height: 0; }
  }
</style>
