---
// @ts-nocheck — deaktivierte Komponente (durch Karte.astro ersetzt); nicht importiert.
import FloatingMascot from "./FloatingMascot.astro";

// Kreationen-Statement. Die Cutouts laufen ausschliesslich als Floating Mascots
// durch die Sektionen — KEIN Cutout-Grid / keine "Wall of Fries" (Spec §4.4.3,
// CI gelockt 2026-05-15). Fixe Online-Speisekarte ist bewusst nicht vorgesehen.
---
<section class="menu has-mascot" id="menu">
  <FloatingMascot
    image="11_Karaage_Panko.png"
    size={160}
    rotate={12}
    top="8%"
    left="4%"
    z={3}
  />
  <FloatingMascot
    image="04_Cheese_Fries.png"
    size={120}
    rotate={-6}
    bottom="14%"
    right="5%"
    z={3}
  />
  <div class="lead">
    <h2>
      Über hundert Kreationen.<br />
      <span class="accent">Wir rotieren — du probierst dich durch.</span>
    </h2>
    <p>
      Klassiker, Saison, Zoo-Edition, Fusion. Die aktuelle Karte liegt am
      Tresen, die Tageskarte oben in der Live-Tafel. Eine feste
      Online-Speisekarte gibt's bewusst nicht — was diese Woche läuft,
      entscheidet die Saison.
    </p>
  </div>
</section>

<style>
  .menu {
    background: var(--cream);
    padding: clamp(60px, 9vw, 110px) clamp(20px, 6vw, 80px);
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }

  .lead {
    max-width: 880px;
    display: grid;
    gap: var(--space-3);
  }

  .lead h2 {
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 5vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }

  .lead h2 .accent { color: var(--accent); }

  .lead p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.6;
    color: color-mix(in oklab, var(--ink) 75%, transparent);
    max-width: 680px;
  }
</style>
