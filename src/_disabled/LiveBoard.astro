---
// @ts-nocheck — deaktivierte Komponente (live-notes-Collection existiert nicht mehr); nicht importiert.
import { getCollection } from "astro:content";
import LiveNote from "./LiveNote.astro";
import FloatingMascot from "./FloatingMascot.astro";

const now = new Date();

const all = await getCollection("live-notes", ({ data }) => {
  if (data.draft) return false;
  if (data.publish_at > now) return false;
  if (data.expires_at <= now) return false;
  return true;
});

const notes = all
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

---
<section class="live-strip has-mascot" id="live">
  <FloatingMascot
    image="03_Crunch_Fries_Chicken.png"
    size={140}
    rotate={-8}
    top="14%"
    right="5%"
  />
  <div class="lead">
    <div>
      <span class="eyebrow">Live · Tagestafel</span>
      <h2>Heute. Hier.<br><span class="accent">Jetzt.</span></h2>
    </div>
    <div class="meta">
      <span class="pulse" aria-hidden="true"></span>Crew schreibt mit Kreide
    </div>
  </div>

  {notes.length > 0 ? (
    <div class="board">
      {notes.map((entry, i) => (
        <LiveNote
          title={entry.data.title}
          tag={entry.data.tag}
          category={entry.data.category}
          body={entry.data.body}
          stamps={entry.data.stamps}
          index={i}
        />
      ))}
    </div>
  ) : (
    <div class="empty">
      <p>
        Die Tagestafel schreibt die Crew am Tresen. Specials gibt&apos;s auf
        <a href="https://www.instagram.com/fry_high2020/" target="_blank" rel="noopener noreferrer">Instagram @fry_high2020</a>.
      </p>
    </div>
  )}

  <a href="#newsletter" class="archive-link">Live per Newsletter mitlesen →</a>
</section>

<style>
  .live-strip {
    background: var(--navy-deep);
    color: var(--cream);
    padding: clamp(52px, 7vw, 88px) clamp(20px, 6vw, 80px);
    position: relative;
    overflow: hidden;
  }

  .live-strip::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 18% 28%, color-mix(in oklab, var(--orange) 18%, transparent) 0%, transparent 38%),
      radial-gradient(circle at 82% 72%, color-mix(in oklab, var(--pink) 14%, transparent) 0%, transparent 38%);
    pointer-events: none;
    z-index: 0;
  }

  .live-strip > * {
    position: relative;
    z-index: 1;
  }

  .lead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
    flex-wrap: wrap;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.65;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2.125rem, 5vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    margin: var(--space-2) 0 0;
    color: var(--cream);
  }

  h2 .accent {
    color: var(--accent);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
    text-align: right;
    line-height: 1.7;
  }

  .pulse {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--orange);
    border-radius: 50%;
    margin-right: 6px;
    animation: pulse-scale 1.8s ease-in-out infinite;
    vertical-align: middle;
  }

  @keyframes pulse-scale {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.6); opacity: 0.5; }
  }

  .board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.7;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 4px;
    transition: opacity var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .archive-link:hover,
  .archive-link:focus-visible {
    opacity: 1;
    color: var(--accent);
  }

  .empty {
    padding: var(--space-7);
    background: color-mix(in oklab, var(--cream) 12%, transparent);
    border: 1px dashed color-mix(in oklab, var(--cream) 25%, transparent);
    border-radius: var(--r-md);
    text-align: center;
    color: var(--cream);
    opacity: 0.7;
  }

  .empty a {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 50%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }

  @media (max-width: 980px) {
    .board { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .board { grid-template-columns: 1fr; }
    .meta { text-align: left; }
  }
</style>
